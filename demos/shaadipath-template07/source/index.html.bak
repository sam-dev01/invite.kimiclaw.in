  <!-- Animated sky elements: birds & motes (preserved from existing design) -->
  <div class="swb-sky-layer" aria-hidden="true">
    <!-- Birds flock 1 — single distant flock, very soft -->
    <div class="swb-birds swb-birds-1">
      <svg viewBox="0 0 60 20" width="52" height="18" fill="none">
        <path d="M0,10 Q8,4 16,10 Q24,4 32,10" stroke="rgba(40,15,5,0.28)" stroke-width="1.4" fill="none"/>
