      </svg>
    </div>
    <!-- Birds flock 2 — hidden via CSS (.swb-birds-2 { display:none }) -->
    <div class="swb-birds swb-birds-2">
      <svg viewBox="0 0 40 14" width="40" height="14" fill="none">
        <path d="M0,7 Q7,2 14,7 Q21,2 28,7" stroke="rgba(40,15,5,0.22)" stroke-width="1.2" fill="none"/>
        <path d="M26,7 Q33,2 40,7" stroke="rgba(40,15,5,0.16)" stroke-width="1.0" fill="none"/>
      </svg>
    </div>
    <!-- Floating pollen motes -->
    <div class="swb-mote swb-mote-1"></div>
    <div class="swb-mote swb-mote-2"></div>
    <div class="swb-mote swb-mote-3"></div>
    <div class="swb-mote swb-mote-4"></div>
  </div>

  <!-- River water surface — three scrolling wave layers -->
  <div class="swb-water-wrap">

    <!-- Wave layer 1: deep/back — slowest -->
    <svg class="swb-wave swb-wave--1" xmlns="assets/svg-b05687485d.bin" viewBox="0 0 2880 320" preserveAspectRatio="none">
      <defs>
        <linearGradient id="swg1" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#D4A890" stop-opacity="0.0"/>
          <stop offset="25%"  stop-color="#C89880" stop-opacity="0.28"/>
          <stop offset="100%" stop-color="#B88070" stop-opacity="0.50"/>
        </linearGradient>
      </defs>
      <path d="M0,160 C240,100 480,220 720,160 C960,100 1200,220 1440,160 C1680,100 1920,220 2160,160 C2400,100 2640,220 2880,160 L2880,320 L0,320 Z" fill="url(#swg1)"/>
    </svg>

    <!-- Wave layer 2: mid shimmer -->
    <svg class="swb-wave swb-wave--2" xmlns="assets/svg-b05687485d.bin" viewBox="0 0 2880 280" preserveAspectRatio="none">
      <defs>
        <linearGradient id="swg2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#DDB898" stop-opacity="0.0"/>
          <stop offset="18%"  stop-color="#CCA080" stop-opacity="0.22"/>
          <stop offset="100%" stop-color="#BF9070" stop-opacity="0.45"/>
        </linearGradient>
        <linearGradient id="swg2s" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"  stop-color="#F0D090" stop-opacity="0.10"/>
          <stop offset="10%" stop-color="#F0D090" stop-opacity="0.0"/>
        </linearGradient>
      </defs>
      <path d="M0,130 C360,60 720,200 1080,130 C1440,60 1800,200 2160,130 C2520,60 2760,180 2880,130 L2880,280 L0,280 Z" fill="url(#swg2)"/>
      <path d="M0,130 C360,60 720,200 1080,130 C1440,60 1800,200 2160,130 C2520,60 2760,180 2880,130 L2880,145 C2760,195 2520,75 2160,145 C1800,215 1440,75 1080,145 C720,215 360,75 0,145 Z" fill="url(#swg2s)"/>
    </svg>

    <!-- Wave layer 3: front/surface — fastest -->
    <svg class="swb-wave swb-wave--3" xmlns="assets/svg-b05687485d.bin" viewBox="0 0 2880 220" preserveAspectRatio="none">
      <defs>
        <linearGradient id="swg3" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#E0C0A0" stop-opacity="0.0"/>
          <stop offset="15%"  stop-color="#CCA880" stop-opacity="0.20"/>
          <stop offset="100%" stop-color="#C09478" stop-opacity="0.42"/>
        </linearGradient>
      </defs>
      <path d="M0,100 C180,50 360,150 540,100 C720,50 900,150 1080,100 C1260,50 1440,150 1620,100 C1800,50 1980,150 2160,100 C2340,50 2610,140 2880,100 L2880,220 L0,220 Z" fill="url(#swg3)"/>
    </svg>

    <!-- Golden light shimmer streaks on water -->
    <div class="swb-shimmer">
      <div class="swb-sh swb-sh--1"></div>
      <div class="swb-sh swb-sh--2"></div>
      <div class="swb-sh swb-sh--3"></div>
      <div class="swb-sh swb-sh--4"></div>
    </div>

    <!-- Ripple rings around each swan -->
    <div class="swb-ripple swb-ripple--l1"></div>
    <div class="swb-ripple swb-ripple--l2"></div>
    <div class="swb-ripple swb-ripple--r1"></div>
    <div class="swb-ripple swb-ripple--r2"></div>

    <!-- Swan A — faces RIGHT, glides left → right -->
    <div class="swb-swan swb-swan--a" id="swbSwanA">
      <img src="assets/Element_9-55e2f12d5b.png" alt="Swan" class="swb-swan-img"
           onerror="this.src='assets/Element_9-55e2f12d5b.png'">
      <div class="swb-swan-wake swb-swan-wake--a"></div>
    </div>

    <!-- Swan B — faces LEFT (mirrored), glides right → left -->
    <div class="swb-swan swb-swan--b" id="swbSwanB">
      <img src="assets/Element_9-55e2f12d5b.png" alt="Swan" class="swb-swan-img swb-swan-img--flip"
           onerror="this.src='assets/Element_9-55e2f12d5b.png'">
      <div class="swb-swan-wake swb-swan-wake--b"></div>
    </div>

  </div><!-- /swb-water-wrap -->

  <!-- Soft veil fades bottom edge into next section -->
  <div class="swb-veil-bottom"></div>

</div>

