<!-- RSVP -->
<section id="rsvp" class="s-rsvp">

  <div class="rsvp-paper-veil"></div>

  <!-- Petal clusters — ruby/gold on parchment -->
  <div class="rsvp-florals" aria-hidden="true">
    <svg class="rsvp-fl rsvp-fl--tl" viewBox="0 0 180 180" fill="none">
      <ellipse cx="60"  cy="90"  rx="18" ry="42" fill="var(--rose)" opacity=".07" transform="rotate(-30 60 90)"/>
      <ellipse cx="90"  cy="55"  rx="14" ry="36" fill="var(--gold)" opacity=".06" transform="rotate(20 90 55)"/>
      <ellipse cx="115" cy="95"  rx="16" ry="38" fill="var(--rose)" opacity=".05" transform="rotate(60 115 95)"/>
      <circle  cx="88"  cy="88"  r="6"            fill="var(--gold)" opacity=".10"/>
    </svg>
    <svg class="rsvp-fl rsvp-fl--br" viewBox="0 0 180 180" fill="none">
      <ellipse cx="60"  cy="90"  rx="18" ry="42" fill="var(--rose)" opacity=".07" transform="rotate(-30 60 90)"/>
      <ellipse cx="90"  cy="55"  rx="14" ry="36" fill="var(--gold)" opacity=".06" transform="rotate(20 90 55)"/>
      <ellipse cx="115" cy="95"  rx="16" ry="38" fill="var(--rose)" opacity=".05" transform="rotate(60 115 95)"/>
      <circle  cx="88"  cy="88"  r="6"            fill="var(--gold)" opacity=".10"/>
    </svg>
    <svg class="rsvp-fl rsvp-fl--tr" viewBox="0 0 120 120" fill="none">
      <ellipse cx="40" cy="60" rx="10" ry="28" fill="var(--rose)" opacity=".07" transform="rotate(15 40 60)"/>
      <ellipse cx="75" cy="45" rx="9"  ry="24" fill="var(--gold)" opacity=".06" transform="rotate(-40 75 45)"/>
    </svg>
    <svg class="rsvp-fl rsvp-fl--bl" viewBox="0 0 120 120" fill="none">
      <ellipse cx="40" cy="60" rx="10" ry="28" fill="var(--rose)" opacity=".07" transform="rotate(15 40 60)"/>
      <ellipse cx="75" cy="45" rx="9"  ry="24" fill="var(--gold)" opacity=".06" transform="rotate(-40 75 45)"/>
    </svg>
  </div>

  <img class="s-diya-l" src="assets/Element_201-a8193248f0.png" alt="" aria-hidden="true">
  <img class="s-diya-r" src="assets/Element_201-a8193248f0.png" alt="" aria-hidden="true">

  <div class="rsvp-toran" aria-hidden="true">
    <img src="assets/Background_204-24ddb4a1ad.png" alt="" class="toran-img">
  </div>

  <div id="petalRsvp" class="petal-canvas"></div>

  <div class="container rsvp-body">

    <!-- Gold ornamental rule -->
    <div class="rsvp-rule scroll-in">
      <svg viewBox="0 0 400 12" width="100%" style="max-width:400px">
        <line x1="0"   y1="6" x2="168" y2="6" stroke="var(--gold)" stroke-width="0.8" opacity=".40"/>
        <path d="M 184 6 m -8 0 a 8 8 0 1 0 16 0 a 8 8 0 1 0 -16 0" fill="none" stroke="var(--gold)" stroke-width="1" opacity=".60"/>
        <line x1="200" y1="6" x2="400" y2="6" stroke="var(--gold)" stroke-width="0.8" opacity=".40"/>
      </svg>
    </div>

    <span class="rsvp-eye scroll-in" style="--sd:.05s">Join the Celebration</span>

    <h2 class="rsvp-heading scroll-in" id="rsvpHeading" style="--sd:.12s">
      Will you <em>join us?</em>
    </h2>

    <p class="rsvp-sub scroll-in" id="rsvpSub" style="--sd:.22s">
      We've saved a seat for you — at our table, in our hearts, and under the royal sky.<br>
      Come celebrate with us as we begin this new chapter together.
    </p>

    <form class="rsvp-form scroll-in" id="rsvpDetailsForm" style="--sd:.28s">
      <div class="rsvp-row">
        <div class="rsvp-field">
          <label for="rsvpName">Your Name</label>
          <input type="text" id="rsvpName" name="name" placeholder="e.g. Aditi Sharma" required>
        </div>
        <div class="rsvp-field">
          <label for="rsvpGuests">Guests</label>
          <input type="number" id="rsvpGuests" name="guests" min="1" max="10" value="1" required>
        </div>
      </div>
      <div class="rsvp-field">
        <label for="rsvpAttending">Will you attend?</label>
        <select id="rsvpAttending" name="attending">
          <option value="Yes, joyfully!">Yes, joyfully! 🎉</option>
          <option value="Not sure yet">Not sure yet</option>
          <option value="Sorry, can't make it">Sorry, can't make it</option>
        </select>
      </div>
    </form>

    <div class="rsvp-cta-wrap scroll-in" style="--sd:.34s">
      <a
        id="rsvpWaBtn"
        class="rsvp-wa-btn"
        href="https://wa.me/919243400679"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="RSVP via WhatsApp"
      >
        <span class="rsvp-wa-shimmer"></span>
        <span class="rsvp-wa-inner">
          <svg class="rsvp-wa-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.554 4.121 1.527 5.855L0 24l6.306-1.506A11.951 11.951 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.37l-.359-.214-3.737.892.93-3.63-.235-.373A9.818 9.818 0 1112 21.818z"/>
          </svg>
          Yes, I'll be there ✨
        </span>
      </a>
    </div>

    <p class="rsvp-ps scroll-in" style="--sd:.44s">
      You'll be redirected to WhatsApp to confirm your attendance.
    </p>

    <div class="scroll-in" style="--sd:.48s">
      <button type="button" class="dl-card-btn" id="dlCardBtn">⬇ Download Invite Card</button>
    </div>

    <!-- Gold rule below -->
    <div class="rsvp-rule scroll-in" style="--sd:.5s">
      <svg viewBox="0 0 400 12" width="100%" style="max-width:400px">
        <line x1="0"   y1="6" x2="168" y2="6" stroke="var(--gold)" stroke-width="0.8" opacity=".40"/>
        <path d="M 184 6 m -8 0 a 8 8 0 1 0 16 0 a 8 8 0 1 0 -16 0" fill="none" stroke="var(--gold)" stroke-width="1" opacity=".60"/>
        <line x1="200" y1="6" x2="400" y2="6" stroke="var(--gold)" stroke-width="0.8" opacity=".40"/>
      </svg>
    </div>

  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <svg class="ft-lotus" viewBox="0 0 70 56" width="64" aria-hidden="true">
    <ellipse cx="35" cy="30" rx="22" ry="14" fill="none" stroke="#F0A800" stroke-width="1.6" opacity=".38"/>
    <ellipse cx="35" cy="18" rx="22" ry="8"  fill="none" stroke="#F0A800" stroke-width="1.2" opacity=".30"/>
    <ellipse cx="35" cy="42" rx="22" ry="8"  fill="none" stroke="#F0A800" stroke-width="1.2" opacity=".30"/>
    <line x1="18" y1="20" x2="18" y2="40" stroke="#C81060" stroke-width=".8" opacity=".30"/>
    <line x1="28" y1="13" x2="28" y2="47" stroke="#C81060" stroke-width=".8" opacity=".25"/>
    <line x1="42" y1="13" x2="42" y2="47" stroke="#C81060" stroke-width=".8" opacity=".25"/>
    <line x1="52" y1="20" x2="52" y2="40" stroke="#C81060" stroke-width=".8" opacity=".30"/>
    <circle cx="60" cy="14" r="5" fill="#C81060" opacity=".42"/>
    <circle cx="60" cy="14" r="2.5" fill="#F0A800" opacity=".55"/>
  </svg>
  <div class="ft-names">Simran &amp; Harjot</div>
  <div class="ft-rule"></div>
  <p class="ft-date">12 December 2026 · Haveli Grand, Ludhiana</p>
  <p class="ft-credit">Crafted with love on <a href="#" target="_blank" rel="noopener">invite.kimiclaw.in</a></p>
</footer>

<script src="assets/script-504e32044a.js"></script>

<!-- ═══════════════════════════════════════
     SHAADIPATH CONFIG LOADER — T07
═══════════════════════════════════════ -->
<script>
(function applyWeddingConfig(){
  'use strict';
  const C=(typeof WEDDING_CONFIG!=='undefined')?WEDDING_CONFIG:null;
  if(!C){initMusic();return;}
  const{couple,invite,events,story,gallery,thingsToKnow,rsvp}=C;
  function fmt(d){try{return new Date(d+'T00:00').toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'});}catch(e){return d||'';}}
  function fmtT(t){if(!t)return'';const[h,m]=t.split(':');const hr=parseInt(h);return(hr%12||12)+':'+(m||'00')+' '+(hr<12?'AM':'PM');}
  function el(id){return document.getElementById(id);}

  /* 1. PAGE TITLE + HERO */
  const dShort=couple.date?new Date(couple.date+'T00:00').toLocaleDateString('en-IN',{day:'2-digit',month:'2-digit',year:'numeric'}):'';
  document.title=couple.bride+' & '+couple.groom+' · '+dShort;
  const heroCopy=el('heroCopy');
  if(heroCopy){
    const bEl=heroCopy.querySelector('.hc-bride span'),gEl=heroCopy.querySelector('.hc-groom span');
    if(bEl)bEl.textContent=couple.bride;
    if(gEl)gEl.textContent=couple.groom;
  }
  const pn1=document.querySelector('.pl-n1'),pn2=document.querySelector('.pl-n2');
  if(pn1)pn1.textContent=couple.bride;
  if(pn2)pn2.textContent=couple.groom;

  /* 2. INVITATION */
  const blessEl=document.querySelector('.i-bless');
  if(blessEl&&invite&&invite.blessing)blessEl.innerHTML=invite.blessing.replace(/\n/g,'<br>');
  const ib=document.querySelector('.i-bride'),ig2=document.querySelector('.i-groom');
  if(ib)ib.textContent=couple.bride;
  if(ig2)ig2.textContent=couple.groom;
  if(invite){
    const bF=[invite.brideFather,invite.brideMother].filter(Boolean).join(' & ')||'Mr. & Mrs. Singh';
    const gF=[invite.groomFather,invite.groomMother].filter(Boolean).join(' & ')||'Mr. & Mrs. Kaur';
    const bPar=el('iBrideParents'),gPar=el('iGroomParents');
    if(bPar)bPar.textContent=bF;
    if(gPar)gPar.textContent=gF;
    if(invite.showGrandparents){
      const bgp=[invite.brideGF,invite.brideGM].filter(Boolean).join(' & ');
      const ggp=[invite.groomGF,invite.groomGM].filter(Boolean).join(' & ');
      const bgpEl=el('iFamGpBride'),ggpEl=el('iFamGpGroom');
      if(bgpEl&&bgp){bgpEl.innerHTML='<em>Blessed by</em><br>'+bgp;bgpEl.style.display='block';}
      if(ggpEl&&ggp){ggpEl.innerHTML='<em>Blessed by</em><br>'+ggp;ggpEl.style.display='block';}
    }
  }

  /* 3. EVENTS */
  const evStage=el('evStage');
  if(evStage&&events&&events.length){
    const half=Math.ceil(events.length/2);
    const maxCols=half;
    evStage.dataset.evCount=events.length;
    evStage.style.setProperty('--ev-cols',maxCols);
    const row2Len=events.length-half;
    evStage.innerHTML=events.map((ev,idx)=>{
      const isRow2=idx>=half;
      const row=isRow2?'ev-row2':'ev-row1';
      const hero=ev.id==='shaadi'||ev.id==='pheras'?'ev-node--hero':'';
      const sd=(idx*.1).toFixed(2);
      const dStr=ev.date?new Date(ev.date+'T00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short'}):'';
      const tStr=fmtT(ev.time);
      const dateLabel=[dStr,tStr].filter(Boolean).join(' · ');
      const mapsLink=ev.mapsLink?`<a href="${ev.mapsLink}" target="_blank" class="ev-cta">📍 Open in Google Maps</a>`:'';
      let colStyle='';
      if(isRow2&&row2Len<maxCols){const r2i=idx-half;const col=row2Len===1?'1/-1':`${Math.round(r2i*(maxCols-1)/(row2Len-1))+1}`;colStyle=`grid-column:${col};`;}
      return`<article class="ev-node ${row} ${hero} scroll-in" style="--sd:${sd}s;${colStyle}" data-idx="${idx}">
        <div class="ev-icon-wrap"><img src="${ev.icon}" alt="${ev.name}" class="ev-icon" loading="lazy" onerror="this.style.display='none'"><div class="ev-glow"></div></div>
        <div class="ev-label"><span class="ev-name">${ev.name}</span><span class="ev-date">${dateLabel}</span></div>
        <div class="ev-detail">${ev.venue?`<p class="ev-venue">${ev.venue}</p>`:''}${ev.desc?`<p class="ev-desc">${ev.desc}</p>`:''}${mapsLink}</div>
      </article>`;
    }).join('');
    setTimeout(()=>{
      evStage.querySelectorAll('.scroll-in').forEach(function(n){n.classList.add('vis');});
      if(typeof initEventsAutoOpen==='function')initEventsAutoOpen();
      if(typeof window._evJourneyLayout==='function')window._evJourneyLayout();
    },120);
  }

  /* 4. STORY */
  if(invite&&invite.show===false){const is=el('invite');if(is)is.style.display='none';}
  if(story&&story.show===false){const ss=el('story');if(ss)ss.style.display='none';}
  else{
    const setText=(id,txt)=>{const e=el(id);if(e&&txt)e.textContent=txt;};
    setText('stRvBride',couple.bride);setText('stRvGroom',couple.groom);
    const tagEl=el('stRvTags');
    if(story&&story.storyMode==='story'&&story.storyText){const ve=el('stRvVerse');if(ve)ve.textContent=story.storyText;if(tagEl)tagEl.style.display='none';}
    else if(tagEl&&story&&story.tags&&story.tags.length)tagEl.innerHTML=story.tags.map(t=>`<span class="st-rv-tag">${t}</span>`).join('');
    const htag=(story&&story.customHashtag)||couple.hashtag||'';
    if(htag)document.querySelectorAll('.tt-ig a').forEach(a=>a.textContent=htag);
  }

  /* 5. GALLERY */
  const galSec=el('gallery');
  if(galSec){
    if(!gallery||!gallery.show||gallery.layout==='skip'){galSec.style.display='none';}
    else if(gallery.photos&&gallery.photos.length){
      const gg=galSec.querySelector('.gal-grid');
      if(gg){
        const n=parseInt(gallery.layout)||4;
        if(n<4) gg.style.gridTemplateColumns='repeat('+n+',1fr)';
        gg.innerHTML=Array.from({length:n},(_,i)=>{
          const p=gallery.photos[i];
          return p
            ?`<div class="gal-item ${i===0&&n===4?'gal-tall':''}"><img src="${p}" style="width:100%;height:100%;object-fit:cover" alt="" loading="lazy"></div>`
            :`<div class="gal-item ${i===0&&n===4?'gal-tall':''}"><div class="gal-ph"><span class="gal-m">S&H</span></div></div>`;
        }).join('');
      }
    }
  }

  /* 6. THINGS TO KNOW */
  const thingsSec=el('things');
  if(C.showThingsToKnow===false){if(thingsSec)thingsSec.style.display='none';}
  else if(thingsToKnow&&thingsToKnow.length){
    const ttRow=document.querySelector('.tt-row');
    const firstIc=ttRow&&ttRow.querySelector('.tt-ic');
    const iconStroke=firstIc?firstIc.getAttribute('stroke'):'#C4985A';
    const custIc='<svg class="tt-ic" viewBox="0 0 32 32" width="36" height="36" fill="none" stroke="'+iconStroke+'" stroke-width="1.3" stroke-linecap="round"><circle cx="16" cy="16" r="11"/><line x1="16" y1="13" x2="16" y2="20"/><circle cx="16" cy="10" r="1" fill="'+iconStroke+'"/></svg>';
    const htag=(story&&story.customHashtag)||couple.hashtag||'';
    const matchedIds=new Set();
    document.querySelectorAll('.tt').forEach(function(card){
      const lEl=card.querySelector('.tt-l'),vEl=card.querySelector('.tt-v');
      if(!lEl||!vEl)return;
      const lbl=lEl.textContent.toLowerCase().trim();
      const m=thingsToKnow.find(function(t){return t.label&&(t.label.toLowerCase().includes(lbl)||lbl.includes(t.label.toLowerCase()));});
      if(m){vEl.textContent=m.id==='hashtag'&&htag?htag:m.value;matchedIds.add(m.id);card.style.display='';}
      else{card.style.display='none';}
    });
    if(ttRow){thingsToKnow.forEach(function(item,i){
      if(matchedIds.has(item.id)||!item.label)return;
      const div=document.createElement('div');
      div.className='tt scroll-in vis';
      div.setAttribute('style','--sd:'+(0.1*i).toFixed(1)+'s');
      div.innerHTML=custIc+'<span class="tt-l">'+item.label+'</span><p class="tt-v">'+item.value+'</p>';
      ttRow.appendChild(div);
    });}
    const igA=document.querySelector('.tt-ig a');
    if(igA)igA.textContent=htag||igA.textContent;
  }else if(thingsSec){thingsSec.style.display='none';}

  /* 7. RSVP */
  const rsvpSec=el('rsvp');
  if(rsvpSec&&rsvp){
    const hEl=el('rsvpHeading');
    if(hEl&&rsvp.heading)hEl.innerHTML=rsvp.heading.replace(/(join us[?!.]?)/i,'<em>$1</em>');
    const subEl=el('rsvpSub');
    if(subEl&&rsvp.subtext)subEl.innerHTML=rsvp.subtext.replace(/\n/g,'<br>');
    const waBtn=el('rsvpWaBtn');
    if(waBtn){
      if(rsvp.mode==='form'){
        if(!rsvp.form_url){ waBtn.style.display='none'; }
        else{ waBtn.href=rsvp.form_url; waBtn.setAttribute('target','_blank'); waBtn.setAttribute('rel','noopener noreferrer'); }
      } else {
        const phone=((couple.whatsapp||rsvp.whatsapp||'').replace(/\D/g,''));
        const full=phone.startsWith('91')?phone:'91'+phone;
        const msg=encodeURIComponent('Hi '+couple.bride+' & '+couple.groom+'! I would love to join your celebration!');
        waBtn.href='https://wa.me/'+full+'?text='+msg;
      }
    }
    const btnInner=rsvpSec.querySelector('.rsvp-wa-inner');
    if(btnInner){
      if(rsvp.mode==='form'&&rsvp.form_url){const ic=btnInner.querySelector('svg');if(ic) ic.style.display='none';btnInner.textContent=rsvp.button_text||'Fill RSVP Form';}
      else if(rsvp.mode!=='form'&&rsvp.btnText){const ic=btnInner.querySelector('svg');btnInner.textContent=rsvp.btnText;if(ic)btnInner.prepend(ic);}
    }
  }

  /* 8. FOOTER */
  const ftN=document.querySelector('.ft-names');
  if(ftN)ftN.textContent=couple.bride+' & '+couple.groom;
  const ftD=document.querySelector('.ft-date');
  if(ftD)ftD.textContent=fmt(couple.date)+(couple.venue?' · '+couple.venue:'');

  initMusic();
  console.log('invite.kimiclaw.in T07: Config applied 🎉');
})();
if(typeof WEDDING_CONFIG==='undefined')initMusic();

/* BACKGROUND MUSIC — improved autoplay (#22) */
function initMusic(){
  if(window.__GALLERY_MODE__)return;
  const audio=document.getElementById('bgMusic');
  const btn=document.getElementById('musicBtn');
  if(!audio||!btn)return;
  if(typeof WEDDING_CONFIG!=='undefined'&&WEDDING_CONFIG.music&&WEDDING_CONFIG.music.src){audio.src=WEDDING_CONFIG.music.src;audio.load();audio.onerror=function(){audio.onerror=null;audio.src='';audio.load();};}
  const iconOn=document.getElementById('musicIconOn'),iconOff=document.getElementById('musicIconOff'),lbl=document.getElementById('musicLabel');
  let playing=false;
  function setUI(p){
    playing=p;
    if(iconOn)iconOn.style.display=p?'none':'';
    if(iconOff)iconOff.style.display=p?'none':'';
    if(lbl)lbl.textContent=p?'♪ Mute':'♪ Music';
    btn.classList.toggle('playing',p);btn.textContent=p?'🔔':'🔕';
  }
  window.toggleMusic=function(){if(playing){audio.pause();setUI(false);}else{audio.play().then(()=>setUI(true)).catch(()=>setUI(false));}};
  function tryAutoplay(){
    audio.volume=0.50;
    audio.play().then(()=>setUI(true)).catch(()=>{
      setUI(false);
      function onFirst(){
        audio.play().then(()=>setUI(true)).catch(()=>{});
        document.removeEventListener('scroll',onFirst);
        document.removeEventListener('click',onFirst);
        document.removeEventListener('touchstart',onFirst);
        document.removeEventListener('keydown',onFirst);
      }
      document.addEventListener('scroll',onFirst,{once:true,passive:true});
      document.addEventListener('click',onFirst,{once:true});
      document.addEventListener('touchstart',onFirst,{once:true,passive:true});
      document.addEventListener('keydown',onFirst,{once:true});
    });
  }
  /* Reduced delay + touchstart fires before scroll on mobile (#22) */
  setTimeout(tryAutoplay,400);
}
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var cfg = window.__WEDDING_CONFIG__;
  if (!cfg || !cfg.calendarUrls) return;

  // Read template's primary color from CSS variables
  var style = getComputedStyle(document.documentElement);
  var primaryBg = (style.getPropertyValue('--primary') ||
                   style.getPropertyValue('--gold') ||
                   style.getPropertyValue('--deep') ||
                   '#3D1E2E').trim();
  var primaryText = (style.getPropertyValue('--ivory') || '#FAF3E8').trim();

  var section = document.createElement('div');
  section.style.cssText = 'text-align:center;padding:40px 20px;';

  section.innerHTML =
    '<div style="font-size:0.55rem;letter-spacing:0.22em;' +
    'text-transform:uppercase;color:rgba(0,0,0,0.35);' +
    'margin-bottom:20px;font-family:inherit;">Save the date</div>' +
    '<div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">' +
    '<a href="' + cfg.calendarUrls.google + '" target="_blank" rel="noopener" ' +
    'style="display:inline-block;padding:12px 24px;' +
    'background:transparent;' +
    'border:1px solid ' + primaryBg + ';' +
    'color:' + primaryBg + ';' +
    'font-size:0.58rem;letter-spacing:0.16em;' +
    'text-transform:uppercase;text-decoration:none;' +
    'font-family:inherit;">Google Calendar</a>' +
    '<a href="' + cfg.calendarUrls.apple + '" download="wedding.ics" ' +
    'style="display:inline-block;padding:12px 24px;' +
    'background:' + primaryBg + ';' +
    'color:' + primaryText + ';' +
    'font-size:0.58rem;letter-spacing:0.16em;' +
    'text-transform:uppercase;text-decoration:none;' +
    'font-family:inherit;">Apple / iCal</a>' +
    '</div>';

  var rsvp = document.getElementById('rsvp') ||
             document.querySelector('[id*="rsvp"]') ||
             document.querySelector('[class*="rsvp"]');
  if (rsvp && rsvp.parentNode) {
    rsvp.parentNode.insertBefore(section, rsvp.nextSibling);
  } else {
    document.body.appendChild(section);
  }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var cfg = window.__WEDDING_CONFIG__;
  if (!cfg || !cfg.invite || cfg.invite.parentsOrder !== 'groom_first') return;
  var bEl = document.getElementById('iBrideParents');
  var gEl = document.getElementById('iGroomParents');
  if (bEl) { var em = bEl.closest('.fam-parents') && bEl.closest('.fam-parents').querySelector('em'); if (em) em.textContent = 'Son of'; }
  if (gEl) { var em2 = gEl.closest('.fam-parents') && gEl.closest('.fam-parents').querySelector('em'); if (em2) em2.textContent = 'Daughter of'; }
});
</script>
</body>
</html>