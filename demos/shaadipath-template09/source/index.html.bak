    <!-- ── Live animation canvas: fireworks ── -->
    <canvas class="rsvp-fireworks-canvas" id="rsvpFireworksCanvas" aria-hidden="true"></canvas>


    <!-- ── Ambient lamp glows (lower courtyard) ── -->
    <div class="rsvp-lamp-glows" aria-hidden="true">
      <span class="rsvp-lamp rsvp-lamp--l"></span>
      <span class="rsvp-lamp rsvp-lamp--r"></span>
      <span class="rsvp-lamp rsvp-lamp--cl"></span>
      <span class="rsvp-lamp rsvp-lamp--cr"></span>
    </div>

    <!-- ── Lotus divider (from provided asset, top of section) ── -->
    <div class="rsvp-lotus-top" aria-hidden="true">
      <img src="assets/pn-rsvp-div-finale-lotus-x-v01-a35800b1f3.webp" alt="" decoding="async" loading="lazy">
    </div>

    <!-- ── Content block ── -->
    <div class="rsvp-content">

      <p  class="rsvp-eyebrow  rsvp-reveal" aria-hidden="true">JOIN THE CELEBRATION</p>

      <h2 class="rsvp-headline rsvp-reveal" id="rsvpHeadline">
        <span class="rsvp-hl-will">Will you</span>
        <span class="rsvp-hl-join">JOIN US?</span>
      </h2>

      <p class="rsvp-body rsvp-reveal">
        We've saved a seat for you — at our table, in our hearts,
        and under the royal sky. Come celebrate with us as we begin
        this new chapter together.
      </p>

      <!-- Primary CTA -->
      <div class="rsvp-cta-wrap rsvp-reveal">
        <a class="rsvp-btn-primary"
           href="assets/910000000000-ac073dc680.bin"
           target="_blank" rel="noreferrer"
           aria-label="RSVP — Yes, I'll be there. Opens WhatsApp.">
          <span class="rsvp-btn-inner">YES, I'LL BE THERE</span>
        </a>
        <p class="rsvp-helper">You'll be redirected to WhatsApp to confirm your attendance.</p>
      </div>

      <!-- Save the Date -->
      <div class="rsvp-std rsvp-reveal">
        <p class="rsvp-std-heading">SAVE THE DATE</p>
        <div class="rsvp-std-btns">
          <a class="rsvp-cal-btn" id="rsvpGcalBtn" href="#" target="_blank" rel="noreferrer"
             aria-label="Add to Google Calendar">
            <svg class="rsvp-cal-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="2" y="3" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M7 1v4M13 1v4M2 8h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            Add to Google Calendar
          </a>
          <a class="rsvp-cal-btn" id="rsvpIcalBtn" href="#" download="aarav-meera-wedding.ics"
             aria-label="Add to Apple Calendar">
            <svg class="rsvp-cal-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="2" y="3" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M7 1v4M13 1v4M2 8h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <path d="M10 11v3M8.5 14h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            Add to Apple Calendar
          </a>
        </div>
      </div>

    </div><!-- /rsvp-content -->

  </section>

  <!-- ═══════════════════════════════════
       CLOSING — Love note farewell
  ═══════════════════════════════════ -->
  <section class="section closing-section" id="closing" aria-labelledby="closingTitle">
    <div class="closing-bg"  aria-hidden="true"></div>
    <div class="closing-veil" aria-hidden="true"></div>

    <div class="closing-content reveal-item">
      <div class="rsvp-closing-frame">
        <span class="rsvp-corner rsvp-corner--tr" aria-hidden="true"></span>
        <span class="rsvp-corner rsvp-corner--bl" aria-hidden="true"></span>

        <img class="closing-lotus"
             src="assets/pn-inv-div-lotus-divider-x-v01-4a396303fc.webp"
             alt="" aria-hidden="true" decoding="async" loading="lazy">

        <p class="closing-eyebrow">With all our love</p>

        <h2 class="closing-names" id="closingTitle">Aarav &amp; Meera</h2>

        <div class="closing-ornament" aria-hidden="true">
          <span></span>
          <svg width="20" height="20" viewBox="0 0 22 22" fill="none" xmlns="assets/svg-b05687485d.bin" aria-hidden="true">
            <ellipse cx="11" cy="8"  rx="2.8" ry="5.8" fill="rgba(216,169,87,.72)" transform="rotate(0   11 11)"/>
            <ellipse cx="11" cy="8"  rx="2.8" ry="5.8" fill="rgba(216,169,87,.52)" transform="rotate(60  11 11)"/>
            <ellipse cx="11" cy="8"  rx="2.8" ry="5.8" fill="rgba(216,169,87,.52)" transform="rotate(-60 11 11)"/>
            <ellipse cx="11" cy="8"  rx="2.2" ry="4.8" fill="rgba(216,169,87,.34)" transform="rotate(120 11 11)"/>
            <ellipse cx="11" cy="8"  rx="2.2" ry="4.8" fill="rgba(216,169,87,.34)" transform="rotate(-120 11 11)"/>
            <ellipse cx="11" cy="8"  rx="1.8" ry="4.2" fill="rgba(216,169,87,.22)" transform="rotate(180 11 11)"/>
            <circle  cx="11" cy="11" r="2.0"  fill="rgba(216,169,87,.85)"/>
          </svg>
          <span></span>
        </div>

        <p class="closing-line">You make this moment complete.</p>
        <p class="closing-date">12 · December · 2026</p>
      </div>
    </div>
  </section>
</main>

<section id="rsvp" class="s-rsvp">

  <div class="rsvp-paper-veil"></div>

  <!-- Petal clusters — ruby/gold on parchment -->
  <div class="rsvp-florals" aria-hidden="true">
    <svg class="rsvp-fl rsvp-fl--tl" viewBox="0 0 180 180" fill="none">
      <ellipse cx="60"  cy="90"  rx="18" ry="42" fill="var(--rose)" opacity=".07" transform="rotate(-30 60 90)"/>
      <ellipse cx="90"  cy="55"  rx="14" ry="36" fill="var(--gold)" opacity=".06" transform="rotate(20 90 55)"/>
      <ellipse cx="115" cy="95"  rx="16" ry="38" fill="var(--rose)" opacity=".05" transform="rotate(60 115 95)"/>
      <circle  cx="88"  cy="88"  r="6"            fill="var(--gold)" opacity=".10"/>
    </svg>
    <svg class="rsvp-fl rsvp-fl--br" viewBox="0 0 180 180" fill="none">
      <ellipse cx="60"  cy="90"  rx="18" ry="42" fill="var(--rose)" opacity=".07" transform="rotate(-30 60 90)"/>
      <ellipse cx="90"  cy="55"  rx="14" ry="36" fill="var(--gold)" opacity=".06" transform="rotate(20 90 55)"/>
      <ellipse cx="115" cy="95"  rx="16" ry="38" fill="var(--rose)" opacity=".05" transform="rotate(60 115 95)"/>
      <circle  cx="88"  cy="88"  r="6"            fill="var(--gold)" opacity=".10"/>
    </svg>
    <svg class="rsvp-fl rsvp-fl--tr" viewBox="0 0 120 120" fill="none">
      <ellipse cx="40" cy="60" rx="10" ry="28" fill="var(--rose)" opacity=".07" transform="rotate(15 40 60)"/>
      <ellipse cx="75" cy="45" rx="9"  ry="24" fill="var(--gold)" opacity=".06" transform="rotate(-40 75 45)"/>
    </svg>
    <svg class="rsvp-fl rsvp-fl--bl" viewBox="0 0 120 120" fill="none">
      <ellipse cx="40" cy="60" rx="10" ry="28" fill="var(--rose)" opacity=".07" transform="rotate(15 40 60)"/>
      <ellipse cx="75" cy="45" rx="9"  ry="24" fill="var(--gold)" opacity=".06" transform="rotate(-40 75 45)"/>
    </svg>
  </div>

  <img class="s-diya-l" src="assets/Element_201-a8193248f0.png" alt="" aria-hidden="true">
  <img class="s-diya-r" src="assets/Element_201-a8193248f0.png" alt="" aria-hidden="true">

  <div class="rsvp-toran" aria-hidden="true">
    <img src="assets/Background_204-24ddb4a1ad.png" alt="" class="toran-img">
  </div>

  <div id="petalRsvp" class="petal-canvas"></div>

  <div class="container rsvp-body">

    <!-- Gold ornamental rule -->
    <div class="rsvp-rule scroll-in">
      <svg viewBox="0 0 400 12" width="100%" style="max-width:400px">
        <line x1="0"   y1="6" x2="168" y2="6" stroke="var(--gold)" stroke-width="0.8" opacity=".40"/>
        <path d="M 184 6 m -8 0 a 8 8 0 1 0 16 0 a 8 8 0 1 0 -16 0" fill="none" stroke="var(--gold)" stroke-width="1" opacity=".60"/>
        <line x1="200" y1="6" x2="400" y2="6" stroke="var(--gold)" stroke-width="0.8" opacity=".40"/>
      </svg>
    </div>

    <span class="rsvp-eye scroll-in" style="--sd:.05s">Join the Celebration</span>

    <h2 class="rsvp-heading scroll-in" id="rsvpHeading" style="--sd:.12s">
      Will you <em>join us?</em>
    </h2>

    <p class="rsvp-sub scroll-in" id="rsvpSub" style="--sd:.22s">
      We've saved a seat for you — at our table, in our hearts, and under the royal sky.<br>
      Come celebrate with us as we begin this new chapter together.
    </p>

    <form class="rsvp-form scroll-in" id="rsvpDetailsForm" style="--sd:.28s">
      <div class="rsvp-row">
        <div class="rsvp-field">
          <label for="rsvpName">Your Name</label>
          <input type="text" id="rsvpName" name="name" placeholder="e.g. Aditi Sharma" required>
        </div>
        <div class="rsvp-field">
          <label for="rsvpGuests">Guests</label>
          <input type="number" id="rsvpGuests" name="guests" min="1" max="10" value="1" required>
        </div>
      </div>
      <div class="rsvp-field">
        <label for="rsvpAttending">Will you attend?</label>
        <select id="rsvpAttending" name="attending">
          <option value="Yes, joyfully!">Yes, joyfully! 🎉</option>
          <option value="Not sure yet">Not sure yet</option>
          <option value="Sorry, can't make it">Sorry, can't make it</option>
        </select>
      </div>
    </form>

    <div class="rsvp-cta-wrap scroll-in" style="--sd:.34s">
      <a
        id="rsvpWaBtn"
        class="rsvp-wa-btn"
        href="https://wa.me/919243400679"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="RSVP via WhatsApp"
      >
        <span class="rsvp-wa-shimmer"></span>
        <span class="rsvp-wa-inner">
          <svg class="rsvp-wa-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.554 4.121 1.527 5.855L0 24l6.306-1.506A11.951 11.951 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.37l-.359-.214-3.737.892.93-3.63-.235-.373A9.818 9.818 0 1112 21.818z"/>
          </svg>
          Yes, I'll be there ✨
        </span>
      </a>
    </div>

    <p class="rsvp-ps scroll-in" style="--sd:.44s">
      You'll be redirected to WhatsApp to confirm your attendance.
    </p>

    <div class="scroll-in" style="--sd:.48s">
      <button type="button" class="dl-card-btn" id="dlCardBtn">⬇ Download Invite Card</button>
    </div>

    <!-- Gold rule below -->
    <div class="rsvp-rule scroll-in" style="--sd:.5s">
      <svg viewBox="0 0 400 12" width="100%" style="max-width:400px">
        <line x1="0"   y1="6" x2="168" y2="6" stroke="var(--gold)" stroke-width="0.8" opacity=".40"/>
        <path d="M 184 6 m -8 0 a 8 8 0 1 0 16 0 a 8 8 0 1 0 -16 0" fill="none" stroke="var(--gold)" stroke-width="1" opacity=".60"/>
        <line x1="200" y1="6" x2="400" y2="6" stroke="var(--gold)" stroke-width="0.8" opacity=".40"/>
      </svg>
    </div>

  </div>
</section>

<footer class="footer" style="text-align:center;padding:28px 16px 36px;background:#0a0908;color:rgba(216,169,87,.72);font-family:inherit;letter-spacing:.08em;font-size:.78rem;">
  <p class="ft-credit" style="margin:0;">Crafted with love on <a href="#" target="_blank" rel="noopener" style="color:#d8a957;text-decoration:none;border-bottom:1px solid rgba(216,169,87,.4);">invite.kimiclaw.in</a></p>
</footer>

