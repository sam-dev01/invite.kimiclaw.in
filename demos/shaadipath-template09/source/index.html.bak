<body class="intro-active">

<!-- ═══════════════════════════════════
     INTRO
═══════════════════════════════════ -->
<section class="intro" id="intro" aria-label="Opening scene">

  <!-- Background layers -->
  <img class="intro-bg intro-bg-dark" id="introBgDark" alt="" aria-hidden="true" decoding="async" fetchpriority="high">
  <img class="intro-bg intro-bg-lit"  id="introBgLit"  alt="" aria-hidden="true" decoding="async">

  <!-- Glow system -->
  <div class="intro-vignette"      aria-hidden="true"></div>
  <div class="intro-dark-vignette" aria-hidden="true"></div>
  <div class="intro-warm-glow"     aria-hidden="true"></div>
  <div class="intro-jhoomer-glow"  aria-hidden="true"></div>
  <div class="intro-rose-scatter"  aria-hidden="true"></div>

  <!-- Particles (lit only) -->
  <div class="intro-dust"   id="introDust"   aria-hidden="true"></div>
  <div class="intro-petals" id="introPetals" aria-hidden="true"></div>

  <!-- Floral clusters — bottom corners, lit only -->
  <img class="intro-floral-left"  id="introFloralLeft"
       alt="" aria-hidden="true" decoding="async">
  <img class="intro-floral-right" id="introFloralRight"
       alt="" aria-hidden="true" decoding="async">

  <!-- Diyas — arch gate floor, lit only -->
  <div class="diya-wrap diya-left" id="diyaWrapLeft">
    <img class="diya-img" id="introDiyaLeft"  alt="" aria-hidden="true" decoding="async">
    <div class="diya-floor-glow"></div>
  </div>
  <div class="diya-wrap diya-right" id="diyaWrapRight">
    <img class="diya-img" id="introDiyaRight" alt="" aria-hidden="true" decoding="async">
    <div class="diya-floor-glow"></div>
  </div>

  <!-- Jhoomer — lit only -->
  <img class="intro-jhoomer" id="introJhoomer"
       alt="" aria-hidden="true" decoding="async">

  <!-- Rope anchor glow -->
  <div class="rope-anchor-glow" aria-hidden="true"></div>

  <!-- ROPE — the hero interaction -->
  <button class="rope-button" id="ropeButton" type="button"
          aria-label="Pull the rope to light our celebration">
    <img class="rope-img" id="ropeImg" alt="" aria-hidden="true" draggable="false">
    <span class="rope-halo" aria-hidden="true"></span>
  </button>

  <!-- Instruction (dark state) -->
  <div class="intro-instruction" id="introInstruction" aria-hidden="true">
    <div class="pull-ritual-cue"></div>
    <span class="pull-label">Pull to light us up</span>
  </div>
  <div class="pull-feedback" id="pullFeedback" aria-hidden="true">A little deeper to wake the lights</div>

  <!-- Text reveal -->
  <div class="intro-reveal" id="introReveal" aria-live="polite">
    <h1 class="names intro-reveal-item" id="introNames">
      <span class="word">Aarav</span> <span class="word amp-wrap"><span class="amp">&amp;</span></span><br><span class="word">Meera</span>
    </h1>
    <div class="ornament intro-reveal-item" id="introOrnament">
      <span></span><i></i><span></span>
    </div>
    <p class="date  intro-reveal-item" id="introDate">12 · December · 2026</p>
    <p class="venue intro-reveal-item" id="introVenue">The Oberoi Udaivilas, Udaipur</p>
  </div>

  <!-- Lotus CTA -->
  <div class="lotus-cta-group" id="lotusCTAGroup">
    <button class="lotus-button" id="lotusButton" type="button"
            aria-label="Tap the lotus to join us">
      <img class="lotus-glow-burst" id="lotusGlowBurst" alt="" aria-hidden="true" decoding="async">
      <img class="lotus-icon-img"   id="lotusIconImg"   alt="" aria-hidden="true" draggable="false">
      <img class="lotus-open-img"   id="lotusOpenImg"   alt="" aria-hidden="true" draggable="false">
    </button>
    <p class="lotus-cta-label" id="lotusButtonText" aria-hidden="true">Tap the lotus to join us</p>
  </div>

  <button class="skip-intro" id="skipIntro" type="button">skip intro</button>
</section>

