  ═══════════════════════════════════ -->
  <section class="section rsvp-section" id="rsvp" aria-labelledby="rsvpHeadline">

    <!-- Background: palace courtyard at night -->
    <div class="rsvp-bg" aria-hidden="true"></div>

    <!-- Subtle readability veil — central gradient, lets bg breathe -->
