<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1" />
<meta name="theme-color" content="#fdf5ee" />
<title>Chitra &amp; Prateek — Save the Date</title>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
<link rel="preload" as="image" href="assets/petal_1.png" />
<link rel="preload" as="image" href="assets/petal_2.png" />

<style>
/* ============================================================
   Save the Date — Mirror Reveal — premium mobile invitation
   Palette: candlelit chamber, aged brass, misty silver fog
   Mirror glass coords (relative to mirror.png):
     left: 15.8%  top: 13.0%  width: 68.4%  height: 72.0%
   Adjust those four values if mirror.png has different border widths.
   ============================================================ */

:root {
  --ivory:       #fbf4e3;
  --ivory-soft:  #f5ead0;
  --gold:        #b8904a;
  --gold-soft:   #d4ad6a;
  --gold-bright: #e8c87e;
  --charcoal:    #0d0a08;
  --mirror-bg:   #0e0c0a;
  --mirror-deep: #080604;
  --fog-base:    #c8d9dd;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html, body, #root {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100svh;
  background: #fdf5ee;
  color: var(--charcoal);
  font-family: 'Cormorant Garamond', 'Times New Roman', serif;
  overscroll-behavior: none;
}
body { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
body.wiping { overflow: hidden; touch-action: none; }

.stage {
  position: relative;
  width: 100%;
  min-height: 100svh;
  overflow: hidden;
  background: transparent;
}

/* ═══════════════════════ INTRO ═══════════════════════ */
.intro {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: opacity 1100ms cubic-bezier(0.4, 0, 0.2, 1);
}
.intro.fade-out { opacity: 0; pointer-events: none; }

.intro video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
}

.intro-veil {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(ellipse 72% 58% at 50% 50%, transparent 32%, rgba(0,0,0,0.64) 100%);
  transition: opacity 700ms ease;
}
.intro-veil.hidden { opacity: 0; }

.tap-prompt {
  position: absolute;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 12vh);
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: var(--ivory);
  text-align: center;
  pointer-events: none;
  animation: breathe 2600ms ease-in-out infinite;
  transition: opacity 500ms ease;
}
.tap-prompt.hidden { opacity: 0; animation: none; pointer-events: none; }
.tap-prompt .flourish {
  display: flex; align-items: center; gap: 10px; opacity: 0.80;
}
.tap-prompt .flourish .line {
  width: 34px; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(120,75,20,0.75), transparent);
}
.tap-prompt .flourish .glyph {
  font-family: 'Cormorant Garamond', serif; font-size: 11px; color: var(--gold);
}
.tap-prompt .prompt-label {
  font-family: 'Cinzel', serif;
  font-weight: 700;
  font-size: clamp(15px, 4.2vw, 19px);
  letter-spacing: 0.44em;
  text-transform: uppercase;
  padding-left: 0.44em;
  color: rgba(120,75,20,0.95);
}
.tap-prompt .prompt-sub {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: clamp(13px, 3.5vw, 15px);
  letter-spacing: 0.10em;
  color: rgba(100,58,12,0.85);
}
@keyframes breathe {
  0%, 100% { opacity: 0.85; transform: translateX(-50%) translateY(0); }
  50%       { opacity: 1;    transform: translateX(-50%) translateY(-3px); }
}

/* ═══════════════════════ CARD ═══════════════════════ */
.card {
  position: relative;
  width: 100%;
  min-height: 100svh;
  background-image: url("assets/std_bg.png");
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: calc(env(safe-area-inset-top) + 24px) 20px calc(env(safe-area-inset-bottom) + 28px);
  opacity: 0;
  transform: scale(1.02);
  transition: opacity 1200ms ease, transform 1600ms cubic-bezier(0.16, 1, 0.3, 1);
}
.card.in { opacity: 1; transform: scale(1); }


/* ─── header ─── */
.eyebrow {
  display: flex; align-items: center; gap: 14px;
  opacity: 0;
  animation: rise 1100ms 180ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
.eyebrow .rule {
  width: clamp(24px, 7vw, 38px); height: 1px;
  background: linear-gradient(90deg, transparent, #2d1a28, transparent);
}
.eyebrow .diamond {
  width: 6px; height: 6px;
  background: #2d1a28;
  transform: rotate(45deg);
}

.title {
  margin: 16px 0 0;
  font-family: 'Cinzel', serif;
  font-weight: 500;
  font-size: clamp(13px, 3.8vw, 17px);
  letter-spacing: 0.50em;
  text-transform: uppercase;
  color: #0f0a0e;
  padding-left: 0.50em;
  text-align: center;
  opacity: 0;
  animation: rise 1100ms 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.couple {
  margin: 8px 0 0;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 600;
  font-size: clamp(34px, 10vw, 52px);
  line-height: 1.05;
  color: #0f0a0e;
  text-align: center;
  text-wrap: balance;
  opacity: 0;
  animation: rise 1200ms 460ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
.couple .amp { color: #1e1018; font-weight: 400; padding: 0 0.06em; }

/* ═══════════════════════ MIRROR ═══════════════════════ */
.mirror-wrap {
  position: relative;
  width: min(78vw, 320px);
  margin: clamp(16px, 3.6vh, 32px) auto 0;
  opacity: 0;
  animation: rise 1400ms 620ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  /* height is driven naturally by the mirror-frame img */
}

/*
  Glass region — pure CSS percentages relative to mirror-wrap.
  mirror-wrap height is driven by the in-flow mirror-frame img, and
  modern mobile browsers resolve % heights on absolute children correctly.
  left:19% top:29% width:62% height:54% matches the inner oval of mirror.png.
*/
.mirror-glass {
  position: absolute;
  left: 19%;
  top: 31%;
  width: 62%;
  height: 57%;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  z-index: 5;
}


/* ─── date text — hidden under fog until revealed ─── */
.date-block {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  text-align: center;
  padding: 10% 12%;
  z-index: 1;
  background: transparent;
}

/* subtle warm shimmer after reveal */
.mirror-glow {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  opacity: 0;
  background: radial-gradient(ellipse at center,
    rgba(212,173,106,0.18) 0%,
    rgba(180,130,55,0.06) 40%,
    transparent 70%);
  transition: opacity 1000ms ease;
}
.mirror-glow.on { opacity: 1; animation: glowPulse 3800ms ease-in-out infinite; }
@keyframes glowPulse {
  0%, 100% { opacity: 0.92; }
  50%       { opacity: 0.52; }
}

/* ─── date text entrance — elements invisible until scratch complete ─── */
.date-block .day,
.date-block .month-row,
.date-block .sep,
.date-block .venue,
.date-block .city {
  opacity: 0;
  animation-fill-mode: both;
}

.date-block.show .day       { animation: rtDay      1300ms   0ms cubic-bezier(0.16,1,0.3,1) both; }
.date-block.show .month-row { animation: rtSlice     900ms 200ms cubic-bezier(0.16,1,0.3,1) both; }
.date-block.show .sep       { animation: rtSep       700ms 400ms ease                       both; }
.date-block.show .venue     { animation: rtRise      900ms 520ms cubic-bezier(0.16,1,0.3,1) both; }
.date-block.show .city      { animation: rtCity      800ms 680ms cubic-bezier(0.16,1,0.3,1) both; }

/* day — cinematic focus-pull: blurry + oversized → sharp + settled */
@keyframes rtDay {
  0%   { opacity: 0; filter: blur(18px); transform: scale(1.18) translateY(8px); }
  60%  { opacity: 1; filter: blur(0);    transform: scale(1.03) translateY(0); }
  82%  { transform: scale(0.99); }
  100% { opacity: 1; filter: blur(0);    transform: scale(1); }
}
/* month row — slices open from the centre outward */
@keyframes rtSlice {
  from { opacity: 0; clip-path: inset(0 50% 0 50%); transform: translateY(4px); }
  to   { opacity: 1; clip-path: inset(0 0% 0 0%);   transform: translateY(0); }
}
/* sep — expands from centre with tiny overshoot */
@keyframes rtSep {
  from { opacity: 0; transform: scaleX(0); }
  78%  { transform: scaleX(1.08); }
  to   { opacity: 1; transform: scaleX(1); }
}
/* venue — gentle rise */
@keyframes rtRise {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
/* city — tracking expands while rising */
@keyframes rtCity {
  from { opacity: 0; transform: translateY(6px); letter-spacing: 0.06em; }
  to   { opacity: 0.88; transform: translateY(0); letter-spacing: 0.20em; }
}

/* ─── date text typography ─── */
.date-block .day {
  font-family: 'Cinzel', serif;
  font-weight: 600;
  font-size: clamp(26px, 8vw, 40px);
  line-height: 1;
  color: #080404;
}
.date-block .month-row {
  display: flex; align-items: center; gap: 7px; margin-top: 5px;
}
.date-block .month-row .bar {
  width: clamp(12px, 3.5vw, 18px); height: 1px;
  background: #1a1010; opacity: 0.55;
}
.date-block .month {
  font-family: 'Cinzel', serif;
  font-weight: 400;
  font-size: clamp(13px, 3.6vw, 17px);
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: #1a1010;
  padding-left: 0.28em;
}
/* sep — only rendered when venue or city is shown */
.date-block .sep {
  margin: clamp(6px, 1.6vw, 10px) 0 clamp(5px, 1.4vw, 8px);
  display: flex; align-items: center; gap: 5px;
  color: #1a1010; font-size: 9px;
}
.date-block .sep::before, .date-block .sep::after {
  content: '';
  width: clamp(10px, 3vw, 18px); height: 1px;
  background: currentColor; opacity: 0.40;
}
.date-block .venue {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 500;
  font-size: clamp(14px, 3.9vw, 18px);
  letter-spacing: 0.03em;
  color: #080404;
  line-height: 1.22;
  text-align: center;
  max-width: 90%;
}
.date-block .city {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 400;
  font-size: clamp(10px, 2.7vw, 13px);
  letter-spacing: 0.20em;
  text-transform: uppercase;
  color: #1a1010;
  margin-top: 4px;
}

/* ─── glass sheen canvas — sits behind fog, shows through wiped region ─── */
.sheen-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
  transition: opacity 700ms ease;
}
.sheen-canvas.gone { opacity: 0; }

/* ─── fog (scratch) canvas ─── */
.fog-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  touch-action: none;
  cursor: grab;
  transition: opacity 700ms ease;
}
.fog-canvas.gone { opacity: 0; pointer-events: none; }
.fog-canvas:active { cursor: grabbing; }

/* breathing fog — living steam, stops the moment user touches */
@keyframes fogBreathe {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.78; }
}
.fog-canvas:not(.gone):not(.started) {
  animation: fogBreathe 2800ms ease-in-out infinite;
}

/* ─── water droplet canvas — same footprint as fog canvas ─── */
.droplet-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 4;
  pointer-events: none;
  transition: opacity 700ms ease;
}
.droplet-canvas.gone { opacity: 0; }

/* ─── wipe hint ─── */
.wipe-hint {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transition: opacity 600ms ease;
}
.wipe-hint.hidden { opacity: 0; }
.wipe-hint .inscription {
  display: flex; flex-direction: column; align-items: center; gap: 7px;
  color: rgba(15,8,14,0.92);
  text-shadow: 0 1px 4px rgba(255,255,255,0.35);
  animation: hintBreathe 3000ms ease-in-out infinite;
}
.wipe-hint .flourish {
  display: flex; align-items: center; gap: 8px; opacity: 0.80;
}
.wipe-hint .flourish .line {
  width: clamp(18px, 5vw, 28px); height: 1px;
  background: linear-gradient(90deg, transparent, rgba(15,8,14,0.55), transparent);
}
.wipe-hint .flourish .glyph {
  font-family: 'Cormorant Garamond', serif; font-size: 10px; color: rgba(15,8,14,0.65);
}
.wipe-hint .text {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 700;
  font-size: clamp(14px, 3.75vw, 17px);
  letter-spacing: 0.05em;
  color: rgba(15,8,14,0.92);
}
.wipe-hint .sub {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: clamp(10px, 2.55vw, 12px);
  color: rgba(15,8,14,0.60);
  letter-spacing: 0.08em;
}
@keyframes hintBreathe {
  0%, 100% { opacity: 0.82; transform: translateY(0); }
  50%       { opacity: 1;    transform: translateY(-2px); }
}

/* ─── mirror frame — in normal flow so it defines mirror-wrap height naturally ─── */
.mirror-frame {
  display: block;
  position: relative;
  width: 100%;
  height: auto;
  pointer-events: none;
  z-index: 3;
  filter:
    drop-shadow(0 14px 28px rgba(0,0,0,0.30))
    drop-shadow(0 3px 8px rgba(80,50,20,0.15));
}

/* ─── below mirror ─── */
.formal {
  margin-top: clamp(16px, 3.5vh, 26px);
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: clamp(20px, 5.1vw, 23px);
  letter-spacing: 0.05em;
  color: rgba(15,8,14,0.78);
  text-align: center;
  opacity: 0;
  animation: rise 1100ms 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
.formal .ornament { color: #8a6030; margin: 0 9px; letter-spacing: 0; }

/* ─── CTA ─── */
.cta-wrap {
  margin-top: calc(clamp(20px, 4vh, 32px) + 30px);
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: 999px;
  background: linear-gradient(180deg, #b47c28 0%, #8a5a16 100%);
  color: var(--ivory);
  text-decoration: none;
  font-family: 'Cinzel', serif;
  font-weight: 500;
  font-size: clamp(9px, 2.3vw, 11px);
  letter-spacing: 0.24em;
  text-transform: uppercase;
  padding-left: calc(18px + 0.24em);
  border: 1px solid rgba(212,173,106,0.50);
  box-shadow: 0 6px 20px rgba(0,0,0,0.38), inset 0 0 0 1px rgba(251,244,227,0.08);
  opacity: 0;
  transform: translateY(10px) scale(0.96);
  transition: opacity 800ms ease, transform 900ms cubic-bezier(0.16,1,0.3,1), box-shadow 300ms ease;
  pointer-events: none;
}
.cta.show { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
.cta:active { transform: scale(0.97); }
.cta .gicon { display: inline-block; width: 12px; height: 12px; }
.cta:hover {
  box-shadow: 0 10px 28px rgba(0,0,0,0.42), inset 0 0 0 1px rgba(251,244,227,0.15);
}

@keyframes rise {
  0%   { opacity: 0; transform: translateY(14px); }
  100% { opacity: 1; transform: translateY(0); }
}

@media (min-width: 520px) {
  .card { padding-top: calc(env(safe-area-inset-top) + 40px); }
}
</style>

<!-- Asset paths — server rewrites these to absolute URLs via regex in buildStdHtml -->
<script>
window.__resources = {
  mirrorImg:  "assets/mirror.png",
  scratchImg: "assets/scratch.png",
  bgImg:      "assets/std_bg.png",
  introVideo: "assets/intro.mp4",
  petal1:     "assets/petal_1.png",
  petal2:     "assets/petal_2.png"
};
</script>
</head>

<body>
<div id="root"></div>

<script src="assets/react.min.js"></script>
<script src="assets/react-dom.min.js"></script>
<script src="assets/babel.min.js"></script>
<script type="text/babel" data-presets="react">
/* global React, ReactDOM */
const { useState, useEffect, useRef, useCallback } = React;

/* ═══════════════════════════════════════════════════════════════
   WaterCanvas
   Two-canvas system, both sized to the mirror glass area:
     fogCanvas    — fog/condensation texture; erased by destination-out
     dropletCanvas— water particle physics rendered on top

   Particle types:
     spray — many tiny droplets scattered in the wipe direction
     roll  — fewer, larger drops that fall under gravity with a
              teardrop trail, simulating water rolling down glass
═══════════════════════════════════════════════════════════════ */
function WaterCanvas({ fogUrl, onComplete }) {
  const fogRef        = useRef(null);
  const dropRef       = useRef(null);
  const sheenRef      = useRef(null);
  const partsRef      = useRef([]);
  const fogImgRef     = useRef(null);
  const rafRef        = useRef(null);
  const lastTRef      = useRef(0);
  const drawingRef    = useRef(false);
  const lastPtRef     = useRef(null);
  const lastCheckRef  = useRef(0);
  const completedRef  = useRef(false);
  const totalOpaqueRef = useRef(0); /* initial opaque pixel count for accurate completion */

  const [hintHidden, setHintHidden] = useState(false);
  const [gone,       setGone]       = useState(false);
  const [supported,  setSupported]  = useState(true);

  /* ── fog canvas: draw scratch.png (white oval fog) as the fog layer ── */
  useEffect(() => {
    const canvas = fogRef.current;
    if (!canvas || !canvas.getContext) { setSupported(false); return; }
    const ctx = canvas.getContext('2d');

    const img = new Image();
    img.onload = () => { fogImgRef.current = img; repaint(); };
    img.onerror = () => { fogImgRef.current = null; repaint(); };
    img.src = fogUrl;

    function repaint() {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.globalCompositeOperation = 'source-over';
      ctx.globalAlpha = 1;
      if (fogImgRef.current) {
        /* scratch.png is already an oval fog on transparent — draw slightly oversized
           so its soft edge fully covers the glass area without any gap */
        const sc = 1.06;
        const dw = rect.width * sc, dh = rect.height * sc;
        ctx.drawImage(fogImgRef.current, (rect.width - dw) / 2, (rect.height - dh) / 2, dw, dh);
      } else {
        /* fallback: plain fog ellipse */
        ctx.fillStyle = 'rgba(228,222,215,0.95)';
        ctx.beginPath();
        ctx.ellipse(rect.width / 2, rect.height / 2, rect.width / 2, rect.height / 2, 0, 0, Math.PI * 2);
        ctx.fill();
      }
      /* measure initial opaque area so checkPercent ignores pre-transparent corners */
      measureInitialOpaque();
    }

    function measureInitialOpaque() {
      const sw = 48, sh = 48;
      const off = document.createElement('canvas');
      off.width = sw; off.height = sh;
      off.getContext('2d').drawImage(canvas, 0, 0, sw, sh);
      const d = off.getContext('2d').getImageData(0, 0, sw, sh).data;
      let n = 0;
      for (let i = 0; i < sw * sh; i++) if (d[i * 4 + 3] >= 24) n++;
      totalOpaqueRef.current = n;
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width  = Math.round(rect.width  * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      repaint();
    }

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);
    return () => ro.disconnect();
  }, [fogUrl]);

  /* ── droplet canvas sizing ── */
  useEffect(() => {
    const pc = dropRef.current;
    if (!pc) return;
    function resizeD() {
      const rect = pc.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      pc.width  = Math.round(rect.width  * dpr);
      pc.height = Math.round(rect.height * dpr);
      pc.getContext('2d').setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resizeD();
    const ro = new ResizeObserver(resizeD);
    ro.observe(pc);
    return () => {
      ro.disconnect();
      if (rafRef.current) cancelAnimationFrame(rafRef.current);
    };
  }, []);

  /* ── sheen canvas sizing ── */
  useEffect(() => {
    const sc = sheenRef.current;
    if (!sc) return;
    function resizeS() {
      const rect = sc.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      sc.width  = Math.round(rect.width  * dpr);
      sc.height = Math.round(rect.height * dpr);
      sc.getContext('2d').setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resizeS();
    const ro = new ResizeObserver(resizeS);
    ro.observe(sc);
    return () => ro.disconnect();
  }, []);

  /* ── particle tick loop ── */
  const ensureLoop = () => {
    if (rafRef.current != null) return;
    lastTRef.current = performance.now();

    const step = (t) => {
      const pc = dropRef.current;
      if (!pc) { rafRef.current = null; return; }
      const ctx  = pc.getContext('2d');
      const rect = pc.getBoundingClientRect();
      const dt   = Math.min(0.05, (t - lastTRef.current) / 1000);
      lastTRef.current = t;
      ctx.clearRect(0, 0, rect.width, rect.height);

      const parts = partsRef.current;
      const next  = [];

      for (let i = 0; i < parts.length; i++) {
        const p = parts[i];

        if (p.type === 'spray') {
          p.vy += 160 * dt;           /* light gravity */
          p.vx *= (1 - 1.8 * dt);    /* strong air drag */
          p.vy *= (1 - 0.55 * dt);
        } else {
          /* roll drop — falls faster, lateral drag is heavy */
          p.vy += 380 * dt;
          p.vx *= (1 - 2.0 * dt);
          p.vy *= (1 - 0.08 * dt);   /* minimal downward drag */
          p.trail.push({ x: p.x, y: p.y });
          if (p.trail.length > p.trailMax) p.trail.shift();
        }

        p.x    += p.vx * dt;
        p.y    += p.vy * dt;
        p.life -= dt;

        if (p.life > 0 && p.y < rect.height + 12) {
          const lr = p.life / p.maxLife;
          const a  = (p.alpha || 0.7) * lr;

          if (p.type === 'spray') {
            /* tiny droplet — simple filled circle */
            ctx.globalAlpha = a;
            ctx.fillStyle = 'rgba(188, 220, 234, 1)';
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fill();
          } else {
            /* rolling drop — teardrop with trailing streak */
            if (p.trail.length > 1) {
              for (let j = 0; j < p.trail.length - 1; j++) {
                const ta = a * (j / p.trail.length) * 0.26;
                ctx.globalAlpha = Math.max(0, ta);
                ctx.strokeStyle = 'rgba(200, 228, 240, 1)';
                ctx.lineWidth   = p.size * 0.5;
                ctx.lineCap     = 'round';
                ctx.beginPath();
                ctx.moveTo(p.trail[j].x, p.trail[j].y);
                ctx.lineTo(p.trail[j + 1].x, p.trail[j + 1].y);
                ctx.stroke();
              }
            }
            /* elongated ellipse angled along travel direction */
            const speed = Math.hypot(p.vx, p.vy);
            const angle = speed > 0.5 ? Math.atan2(p.vy, p.vx) : Math.PI / 2;
            const elong = Math.min(1.85, 1 + speed * 0.0028);
            ctx.globalAlpha = a;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(angle - Math.PI / 2);
            ctx.scale(1, elong);
            const gr = ctx.createRadialGradient(-p.size*0.18, -p.size*0.28, 0, 0, 0, p.size);
            gr.addColorStop(0,   'rgba(235, 248, 255, 0.96)');
            gr.addColorStop(0.4, 'rgba(188, 222, 238, 0.88)');
            gr.addColorStop(1,   'rgba(148, 195, 218, 0.50)');
            ctx.fillStyle = gr;
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
            /* specular highlight */
            ctx.globalAlpha = a * 0.62;
            ctx.fillStyle = 'rgba(255,255,255,0.92)';
            ctx.beginPath();
            ctx.arc(-p.size * 0.22, -p.size * 0.30, p.size * 0.28, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
          next.push(p);
        }
      }

      ctx.globalAlpha = 1;
      partsRef.current = next;
      if (next.length > 0) {
        rafRef.current = requestAnimationFrame(step);
      } else {
        rafRef.current = null;
      }
    };
    rafRef.current = requestAnimationFrame(step);
  };

  /* ── particle spawning ── */
  const spawnDroplets = (x, y, count, dx, dy) => {
    /* x, y are in fog-canvas logical coords (= droplet-canvas coords) */
    const speed = Math.hypot(dx, dy);
    const dirX  = speed > 0.01 ? dx / speed : 0;
    const dirY  = speed > 0.01 ? dy / speed : 0.35;

    const parts = partsRef.current;

    /* spray drops — many tiny, scatter in wipe direction */
    for (let i = 0; i < count; i++) {
      const spread = (Math.random() - 0.5) * 2.4;
      const cs = Math.cos(spread), sn = Math.sin(spread);
      const vx0 = dirX * cs - dirY * sn;
      const vy0 = dirX * sn + dirY * cs;
      const pwr = 16 + Math.random() * 72 + Math.min(90, speed * 1.1);
      parts.push({
        type:    'spray',
        x:       x + (Math.random() - 0.5) * 10,
        y:       y + (Math.random() - 0.5) * 10,
        vx:      vx0 * pwr + (Math.random() - 0.5) * 16,
        vy:      vy0 * pwr + Math.random() * 14 + 6,   /* slight downward bias */
        size:    0.15 + Math.random() * 0.55,
        alpha:   0.32 + Math.random() * 0.30,
        life:    0.22 + Math.random() * 0.26,
        maxLife: 0.48,
      });
    }

    /* roll drops — fewer, larger, primarily fall straight down */
    const rollCnt = Math.max(1, Math.round(count / 5));
    for (let i = 0; i < rollCnt; i++) {
      parts.push({
        type:     'roll',
        x:        x + (Math.random() - 0.5) * 8,
        y:        y + (Math.random() - 0.5) * 6,
        vx:       dirX * (6 + Math.random() * 16) + (Math.random() - 0.5) * 7,
        vy:       4 + Math.random() * 24 + Math.abs(dirY) * 8,
        size:     0.7 + Math.random() * 1.2,
        alpha:    0.55 + Math.random() * 0.25,
        life:     0.7 + Math.random() * 0.7,
        maxLife:  1.4,
        trail:    [],
        trailMax: 11,
      });
    }

    if (parts.length > 600) parts.splice(0, parts.length - 600);
    ensureLoop();
  };

  /* ── pointer helpers ── */
  const getPos = (e) => {
    const rect = fogRef.current.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
  };

  const wipeAt = (x, y) => {
    const canvas = fogRef.current;
    const ctx    = canvas.getContext('2d');
    const rect   = canvas.getBoundingClientRect();
    const r = Math.max(18, Math.min(28, rect.width * 0.092));

    /* erase fog */
    ctx.globalCompositeOperation = 'destination-out';
    const gr = ctx.createRadialGradient(x, y, 0, x, y, r);
    gr.addColorStop(0,    'rgba(0,0,0,1)');
    gr.addColorStop(0.58, 'rgba(0,0,0,0.87)');
    gr.addColorStop(1,    'rgba(0,0,0,0)');
    ctx.fillStyle = gr;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();

    /* paint glass sheen in the cleared region — accumulates with each stroke
       giving a pearlescent "just-wiped mirror" quality to the exposed area */
    const sc = sheenRef.current;
    if (sc) {
      const sctx = sc.getContext('2d');
      sctx.globalCompositeOperation = 'source-over';
      const sg = sctx.createRadialGradient(x, y, 0, x, y, r * 1.15);
      sg.addColorStop(0,    'rgba(218, 235, 245, 0.13)');
      sg.addColorStop(0.40, 'rgba(200, 222, 238, 0.07)');
      sg.addColorStop(1,    'rgba(255, 255, 255, 0)');
      sctx.fillStyle = sg;
      sctx.beginPath();
      sctx.arc(x, y, r * 1.15, 0, Math.PI * 2);
      sctx.fill();
    }
  };

  const wipeLine = (a, b) => {
    const dx   = b.x - a.x, dy = b.y - a.y;
    const dist = Math.hypot(dx, dy);
    const rect = fogRef.current.getBoundingClientRect();
    const r    = Math.max(18, Math.min(28, rect.width * 0.092));
    const step = Math.max(2, r * 0.36);
    const steps = Math.max(1, Math.floor(dist / step));
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      wipeAt(a.x + dx * t, a.y + dy * t);
    }
    const n = Math.min(14, Math.max(4, Math.round(dist / 3.0)));
    spawnDroplets(b.x, b.y, n, dx, dy);
  };

  /* ── completion check — ratio of fog oval wiped (excludes pre-transparent corners) ── */
  const checkPercent = () => {
    const canvas = fogRef.current;
    if (!canvas) return 0;
    const sw = 48, sh = 48;
    const off = document.createElement('canvas');
    off.width = sw; off.height = sh;
    off.getContext('2d').drawImage(canvas, 0, 0, sw, sh);
    const data = off.getContext('2d').getImageData(0, 0, sw, sh).data;
    let transparent = 0;
    for (let i = 0; i < sw * sh; i++) if (data[i * 4 + 3] < 24) transparent++;
    const total = totalOpaqueRef.current || (sw * sh);
    const alreadyClear = (sw * sh) - total; /* corners transparent before any wiping */
    const wiped = Math.max(0, transparent - alreadyClear);
    return wiped / total;
  };

  const finish = useCallback(() => {
    if (completedRef.current) return;
    completedRef.current = true;
    setGone(true);
    onComplete && onComplete(); // fire immediately — petal shower starts as fog fades
    setTimeout(() => {
      const canvas = fogRef.current;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }, 700);
  }, [onComplete]);

  /* ── pointer events ── */
  const onPointerDown = (e) => {
    if (completedRef.current) return;
    e.preventDefault();
    e.currentTarget.setPointerCapture(e.pointerId);
    drawingRef.current = true;
    setHintHidden(true);
    document.body.classList.add('wiping');
    const p = getPos(e);
    lastPtRef.current = p;
    wipeAt(p.x, p.y);
    spawnDroplets(p.x, p.y, 10, 0, 0.3);
  };

  const onPointerMove = (e) => {
    if (!drawingRef.current || completedRef.current) return;
    e.preventDefault();
    const p    = getPos(e);
    const last = lastPtRef.current || p;
    wipeLine(last, p);
    lastPtRef.current = p;
    const now = performance.now();
    if (now - lastCheckRef.current > 300) {
      lastCheckRef.current = now;
      if (checkPercent() >= 0.52) finish();
    }
  };

  const onPointerUp = (e) => {
    drawingRef.current = false;
    lastPtRef.current  = null;
    document.body.classList.remove('wiping');
    try { e.currentTarget.releasePointerCapture(e.pointerId); } catch (_) {}
    if (!completedRef.current && checkPercent() >= 0.52) finish();
  };

  /* fallback for non-canvas browsers */
  if (!supported) {
    return (
      <button
        style={{
          position:'absolute', bottom:'12%', left:'50%',
          transform:'translateX(-50%)', zIndex:6,
          padding:'10px 20px', borderRadius:'999px',
          background:'rgba(180,130,55,0.9)', color:'#fbf4e3',
          border:'1px solid rgba(212,173,106,0.6)',
          fontFamily:"'Cinzel', serif", fontSize:'11px',
          letterSpacing:'0.3em', textTransform:'uppercase',
          paddingLeft:'calc(20px + 0.3em)',
        }}
        onClick={() => { setGone(true); setTimeout(() => onComplete && onComplete(), 400); }}
      >Tap to Reveal</button>
    );
  }

  return (
    <React.Fragment>
      <canvas ref={sheenRef} className={`sheen-canvas ${gone ? 'gone' : ''}`} />
      <canvas
        ref={fogRef}
        className={`fog-canvas ${gone ? 'gone' : ''} ${hintHidden ? 'started' : ''}`}
        onPointerDown={onPointerDown}
        onPointerMove={onPointerMove}
        onPointerUp={onPointerUp}
        onPointerCancel={onPointerUp}
      />
      <canvas ref={dropRef} className={`droplet-canvas ${gone ? 'gone' : ''}`} />
      <div className={`wipe-hint ${hintHidden || gone ? 'hidden' : ''}`}>
        <div className="inscription">
          <div className="flourish">
            <span className="line" />
            <span className="glyph">✦</span>
            <span className="line" />
          </div>
          <div className="text">gently wipe to reveal</div>
          <div className="sub">like clearing a fogged mirror</div>
        </div>
      </div>
    </React.Fragment>
  );
}

/* ═══════════════════════════════════════════════════════════════
   PetalShower — cinematic slow-fall, ~28 petals total
   ─ Depth planes: each petal has a depth (0.45–1) that scales
     its size, speed, opacity → natural parallax sense of space
   ─ Dual-frequency sway: primary + micro sway for organic drift
   ─ 3D flip: ctx.scale(cos(flipT), 1) makes petal catch the wind
   ─ Fade-in at top, fade-out at bottom — never abrupt
   ─ Slow graceful fall: 28–60 px/s — cinematic, not carnival
═══════════════════════════════════════════════════════════════ */
function PetalShower({ active, petal1Url, petal2Url }) {
  const canvasRef  = useRef(null);
  const petalsRef  = useRef([]);
  const rafRef     = useRef(null);
  const imgsRef    = useRef([null, null]);
  const spawnUntil = useRef(0);
  const lastSpawn  = useRef(0);
  const startedRef = useRef(false);

  useEffect(() => {
    [petal1Url, petal2Url].forEach((url, i) => {
      const img = new Image();
      img.src = url;
      imgsRef.current[i] = img;
    });
  }, [petal1Url, petal2Url]);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    function resize() {
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);
    return () => window.removeEventListener('resize', resize);
  }, []);

  useEffect(() => {
    if (!active || startedRef.current) return;
    startedRef.current = true;

    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    /* 5.5 s spawn window → ~28–32 petals at one per ~180 ms */
    spawnUntil.current = performance.now() + 5500;

    function spawnPetal() {
      const depth = 0.42 + Math.random() * 0.58;      /* 0.42 far … 1.0 close */
      const idx   = Math.random() < 0.5 ? 0 : 1;
      petalsRef.current.push({
        img:        imgsRef.current[idx],
        x:          Math.random() * canvas.width,
        y:          -24 - Math.random() * 70,
        vy:         (28 + Math.random() * 32) * depth, /* slow: 12–60 px/s */
        rot:        Math.random() * Math.PI * 2,
        /* gentle rotation — real petals don't spin fast */
        rotSpeed:   (Math.random() < 0.5 ? 1 : -1) * (0.18 + Math.random() * 0.52),
        size:       (22 + Math.random() * 16) * depth,
        /* deeper petals more translucent → sense of aerial depth */
        alpha:      (0.50 + Math.random() * 0.35) * (0.55 + depth * 0.45),
        depth,
        /* dual-frequency sway — slow primary + subtle micro */
        s1Amp:      (20 + Math.random() * 30) * depth,
        s1Freq:     0.14 + Math.random() * 0.18,       /* Hz — very slow */
        s1T:        Math.random() * Math.PI * 2,
        s2Amp:      (5  + Math.random() * 10) * depth,
        s2Freq:     0.42 + Math.random() * 0.38,
        s2T:        Math.random() * Math.PI * 2,
        /* 3D flip — petal catching the air */
        flipT:      Math.random() * Math.PI * 2,
        flipSpeed:  (Math.random() < 0.5 ? 1 : -1) * (0.55 + Math.random() * 0.90),
        /* slow lateral drift — like a gentle breeze */
        drift:      (Math.random() - 0.5) * 18 * depth,
      });
    }

    let last = performance.now();
    function step(now) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      /* one petal (occasionally two) every ~180 ms */
      if (now < spawnUntil.current && now - lastSpawn.current > 180) {
        lastSpawn.current = now;
        spawnPetal();
        if (Math.random() < 0.28) spawnPetal(); /* rare double */
      }

      const alive = [];
      for (let i = 0; i < petalsRef.current.length; i++) {
        const p = petalsRef.current[i];

        /* very soft gravity — air resistance keeps them floating */
        p.vy    += 12 * p.depth * dt;
        p.y     += p.vy * dt;
        p.x     += p.drift * dt;
        p.s1T   += p.s1Freq * dt * Math.PI * 2;
        p.s2T   += p.s2Freq * dt * Math.PI * 2;
        p.rot   += p.rotSpeed * dt;
        p.flipT += p.flipSpeed * dt;

        if (p.y > canvas.height + 60) continue;

        const swayX = Math.sin(p.s1T) * p.s1Amp + Math.sin(p.s2T) * p.s2Amp;

        /* fade in over first 6% of screen, fade out over last 22% */
        let a = p.alpha;
        if (p.y < canvas.height * 0.06) {
          a *= Math.max(0, p.y / (canvas.height * 0.06));
        }
        const fadeEdge = canvas.height * 0.78;
        if (p.y > fadeEdge) {
          a *= Math.max(0, 1 - (p.y - fadeEdge) / (canvas.height * 0.22));
        }
        if (a < 0.01) { alive.push(p); continue; }

        const flip = Math.cos(p.flipT); /* -1 … 1 — simulates 3-D rotation */

        if (p.img && p.img.complete && p.img.naturalWidth > 0) {
          ctx.save();
          ctx.globalAlpha = a;
          ctx.translate(p.x + swayX, p.y);
          ctx.rotate(p.rot);
          ctx.scale(flip, 1);
          ctx.drawImage(p.img, -p.size / 2, -p.size / 2, p.size, p.size);
          ctx.restore();
        }
        alive.push(p);
      }
      petalsRef.current = alive;

      if (alive.length > 0 || now < spawnUntil.current) {
        rafRef.current = requestAnimationFrame(step);
      } else {
        rafRef.current = null;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }

    rafRef.current = requestAnimationFrame(step);
    return () => { if (rafRef.current) cancelAnimationFrame(rafRef.current); };
  }, [active]);

  return (
    <canvas
      ref={canvasRef}
      style={{
        position:      'fixed',
        inset:         0,
        width:         '100%',
        height:        '100%',
        pointerEvents: 'none',
        zIndex:        200,
      }}
    />
  );
}

/* ═══════════════════════════════════════════════════════════════
   GoogleIcon
═══════════════════════════════════════════════════════════════ */
function GoogleIcon() {
  return (
    <svg className="gicon" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#fbf4e3" d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5z"/>
      <circle cx="12" cy="15" r="2.4" fill="#d4ad6a"/>
    </svg>
  );
}

/* ═══════════════════════════════════════════════════════════════
   SaveTheDate — top-level page component
   Phases: intro → (tap) → video → (end) → transition → card
   Card: header + mirror-wrap with WaterCanvas
═══════════════════════════════════════════════════════════════ */
function SaveTheDate({
  title       = 'Save the Date',
  coupleName  = 'Chitra & Prateek',
  date        = '14 June 2026',
  venue       = 'The Westin Sohna',
  city        = 'Gurgaon, Haryana',
  calendarUrl = '',
  ctaText     = 'Save to Google Calendar',
  showVenue   = true,
  showCity    = true,
  showCta     = true,
}) {
  const _gallery = !!(window.__STD_GALLERY_MODE__);
  const [phase,    setPhase]    = useState(_gallery ? 'card' : 'intro');
  const [tapped,   setTapped]   = useState(false);
  const [cardIn,   setCardIn]   = useState(_gallery);
  const [revealed, setRevealed] = useState(false);
  const videoRef = useRef(null);

  /* parse "14 June 2026" → { day, month, year } */
  const dateParts = (() => {
    const m = /^(\d+)\s+(\w+)\s+(\d{4})$/.exec(date.trim());
    if (m) return { day: m[1].padStart(2, '0'), month: m[2], year: m[3] };
    return { day: date, month: '', year: '' };
  })();

  /* split "Bride & Groom" */
  const coupleParts = (() => {
    const m = /^(.+?)\s*&\s*(.+)$/.exec(coupleName);
    return m ? { a: m[1].trim(), b: m[2].trim() } : { a: coupleName, b: '' };
  })();

  const transitionToCard = () => {
    setPhase('transition');
    setTimeout(() => {
      setPhase('card');
      requestAnimationFrame(() => requestAnimationFrame(() => setCardIn(true)));
    }, 1100);
  };

  const handleIntroTap = () => {
    if (tapped) return;
    setTapped(true);
    const v = videoRef.current;
    if (!v) { transitionToCard(); return; }
    v.muted = true;
    setPhase('video');
    const p = v.play();
    if (p && p.catch) p.catch(() => transitionToCard());
  };

  /* seek to first frame once the browser has decoded data — currentTime=0.001 forces the frame to paint */
  useEffect(() => {
    const v = videoRef.current;
    if (!v) return;
    const showFirstFrame = () => { try { v.currentTime = 0.001; } catch (_) {} };
    if (v.readyState >= 2) showFirstFrame();
    else v.addEventListener('loadeddata', showFirstFrame, { once: true });
    return () => v.removeEventListener('loadeddata', showFirstFrame);
  }, []);

  const onReveal = () => setRevealed(true);

  return (
    <div className="stage">

      {/* ── INTRO ── */}
      {phase !== 'card' && (
        <div
          className={`intro ${phase === 'transition' ? 'fade-out' : ''}`}
          onClick={handleIntroTap}
        >
          <video
            ref={videoRef}
            src={window.__resources.introVideo}
            poster="assets/poster.png"
            playsInline
            preload="auto"
            muted
            onEnded={transitionToCard}
          />
          <div className={`intro-veil ${tapped ? 'hidden' : ''}`} />
          <div className={`tap-prompt ${tapped ? 'hidden' : ''}`}>
            <div className="flourish">
              <span className="line" />
              <span className="glyph">✦</span>
              <span className="line" />
            </div>
            <div className="prompt-label">Tap to Begin</div>
            <div className="prompt-sub">a wedding invitation</div>
          </div>
        </div>
      )}

      {/* ── PETAL SHOWER — full-screen overlay, triggers once on reveal ── */}
      <PetalShower
        active={revealed}
        petal1Url={window.__resources.petal1}
        petal2Url={window.__resources.petal2}
      />

      {/* ── CARD ── */}
      {(phase === 'card' || phase === 'transition') && (
        <div className={`card ${cardIn ? 'in' : ''}`}>

          {/* header */}
          <div className="eyebrow">
            <span className="rule" />
            <span className="diamond" />
            <span className="rule" />
          </div>
          <h1 className="title">{title}</h1>
          <div className="couple">
            <span>{coupleParts.a}</span>
            <span className="amp"> &amp; </span>
            <span>{coupleParts.b}</span>
          </div>

          {/* mirror */}
          <div className="mirror-wrap">

            <div className="mirror-glass">
              <div className={`mirror-glow ${revealed ? 'on' : ''}`} />

              {/* date text revealed as fog is wiped away */}
              <div className={`date-block ${revealed ? 'show' : ''}`} aria-hidden={!revealed}>
                <div className="day">{dateParts.day}</div>
                <div className="month-row">
                  <span className="bar" />
                  <span className="month">{dateParts.month} {dateParts.year}</span>
                  <span className="bar" />
                </div>
                {(showVenue || showCity) && <div className="sep" />}
                {showVenue && <div className="venue">{venue}</div>}
                {showCity  && <div className="city">{city}</div>}
              </div>

              {/* fog + water droplets */}
              <WaterCanvas
                fogUrl={window.__resources.scratchImg}
                onComplete={onReveal}
              />
            </div>

            <img
              src={window.__resources.mirrorImg}
              alt=""
              className="mirror-frame"
              draggable="false"
            />
          </div>

          {/* below-mirror text */}
          <div className="formal">
            <span className="ornament">❧</span>
            Formal invitation to follow
            <span className="ornament">❦</span>
          </div>

          {/* Google Calendar CTA — visible only after reveal */}
          {showCta && (
            <div className="cta-wrap">
              <a
                className={`cta ${revealed ? 'show' : ''}`}
                href={calendarUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-hidden={!revealed}
                tabIndex={revealed ? 0 : -1}
              >
                <GoogleIcon />
                <span>{ctaText}</span>
              </a>
            </div>
          )}
        </div>
      )}
    </div>
  );
}

/* ── mount ── */
const root = ReactDOM.createRoot(document.getElementById('root'));
const _cfg  = window.__STD_CONFIG__ || {};
root.render(
  <SaveTheDate
    title={_cfg.title || 'Save the Date'}
    coupleName={_cfg.coupleName || 'Chitra & Prateek'}
    date={_cfg.date || '14 June 2026'}
    venue={_cfg.venue || 'The Westin Sohna'}
    city={_cfg.city || _cfg.location || 'Gurgaon, Haryana'}
    calendarUrl={_cfg.calendarUrl || ''}
    ctaText={_cfg.ctaText || 'Save to Google Calendar'}
    showVenue={_cfg.showVenue !== false}
    showCity={_cfg.showCity !== false}
    showCta={_cfg.showCta !== false}
  />
);
</script>
</body>
</html>
