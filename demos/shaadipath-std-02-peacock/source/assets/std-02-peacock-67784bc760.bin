<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1" />
<meta name="theme-color" content="#6c2a3d" />
<title>Chitra &amp; Prateek — Save the Date</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap"
  rel="stylesheet" />
<link rel="preload" as="image" href="assets/petal_shaadi.webp" />
<link rel="stylesheet" href="styles.css" />
</head>
<body>
<div id="root"></div>

<script src="assets/react.min.js"></script>
<script src="assets/react-dom.min.js"></script>
<script src="assets/babel.min.js"></script>
<script type="text/babel" data-presets="react">
/* global React, ReactDOM */
const { useState, useEffect, useRef, useMemo } = React;

/* ─────────────────────────────────────────────────────────
   PetalLayer
   Idle  — each petal breathes with a slow unique float
   Tap   — ripple from touch point; petals drift outward along
           curved arcs and settle onto the jharoka frame:
           Mughal pointed arch (top) · pillars (sides) · base
   Reveal— layer dissolves gently; date remains
───────────────────────────────────────────────────────── */
function PetalLayer({ onComplete, isRevealed }) {
  const layerRef = useRef(null);
  const elRefs   = useRef([]);
  const stateRef = useRef('idle');
  const rafRef   = useRef(null);

  const petals = useMemo(() => {
    let seed = 1337;
    const rand = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };
    const cols = 5, rows = 7, out = [];
    let id = 0;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const bx = 8 + (c + 0.5) * (84 / cols);
        const by = 5 + (r + 0.5) * (90 / rows);
        out.push({
          id:    id++,
          lp:    bx + (rand() - 0.5) * 12,
          tp:    by + (rand() - 0.5) * 10,
          sz:    34 + rand() * 22,
          rot:   (rand() * 180) - 90,
          z:     10 + id,
          fAmp:  1.8 + rand() * 2.8,
          fT:    2800 + rand() * 2600,
          fPh:   rand() * Math.PI * 2,
          spin:  (rand() < 0.5 ? 1 : -1) * (110 + rand() * 220),
          oscA:  5 + rand() * 10,
          oscF:  1.1 + rand() * 1.4,
        });
      }
    }
    for (let i = 0; i < 8; i++) {
      out.push({
        id: id++, lp: 3+rand()*94, tp: 3+rand()*94,
        sz: 30+rand()*22, rot:(rand()*180)-90, z:70+i,
        fAmp:1.8+rand()*2.8, fT:2800+rand()*2600, fPh:rand()*Math.PI*2,
        spin:(rand()<0.5?1:-1)*(110+rand()*220),
        oscA:5+rand()*10, oscF:1.1+rand()*1.4,
      });
    }
    return out;
  }, []);

  useEffect(() => {
    const layer = layerRef.current;
    if (!layer) return;
    let floatRaf;
    const t0 = performance.now();

    /* ── idle: each petal breathes with its own slow sine float ── */
    const floatTick = (now) => {
      if (stateRef.current !== 'idle') return;
      const t = now - t0;
      petals.forEach((p, i) => {
        const el = elRefs.current[i];
        if (!el) return;
        const dy = Math.sin(t / p.fT * Math.PI * 2 + p.fPh) * p.fAmp;
        const dx = Math.cos(t / (p.fT * 1.35) * Math.PI * 2 + p.fPh + 1.1) * p.fAmp * 0.45;
        el.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) rotate(${p.rot}deg)`;
      });
      floatRaf = requestAnimationFrame(floatTick);
    };
    floatRaf = requestAnimationFrame(floatTick);

    /* ── tap: all petals fly to the jharoka frame ── */
    const handleTap = (e) => {
      if (stateRef.current !== 'idle') return;
      stateRef.current = 'animating';
      cancelAnimationFrame(floatRaf);

      const tapX = e.clientX, tapY = e.clientY;
      const wrap  = layer.parentElement.getBoundingClientRect();
      const lr    = layer.getBoundingClientRect();
      const W = wrap.width, H = wrap.height;
      const ox = wrap.left,  oy = wrap.top;
      const N = petals.length;

      /* ── border points along the ACTUAL jharoka shape ──────────────────
         Jharoka anatomy (% of wrap dimensions):
           Mughal pointed arch: spans x 26–74%, peaks at (50%, 7%)
           Left pillar:  x ≈ 5–22%,  y ≈ 5–88%
           Right pillar: x ≈ 78–95%, y ≈ 5–88%
           Bottom base:  y ≈ 88–96%, x ≈ 6–94%
      ─────────────────────────────────────────────────────────────────── */
      const archN  = Math.round(N * 0.34);
      const leftN  = Math.round(N * 0.17);
      const rightN = Math.round(N * 0.17);
      const botN   = N - archN - leftN - rightN;
      const bPts   = [];

      /* — arch: two quadratic bezier halves meeting at the pointed peak — */
      const half = Math.ceil(archN / 2);
      /* left half: arch-base-left (26%,20%) → peak (50%,7%) */
      const alx0=W*0.26, aly0=H*0.20, alCx=W*0.36, alCy=H*0.04, aMx=W*0.50, aMy=H*0.08;
      for (let i = 0; i < half; i++) {
        const t = i / Math.max(1, half - 1);
        const x = (1-t)*(1-t)*alx0 + 2*t*(1-t)*alCx + t*t*aMx;
        const y = (1-t)*(1-t)*aly0 + 2*t*(1-t)*alCy + t*t*aMy;
        bPts.push({ x: ox+x + Math.sin(i*19.3)*9, y: oy+y + Math.cos(i*19.3)*6 });
      }
      /* right half: peak (50%,7%) → arch-base-right (74%,20%) */
      const arx1=W*0.74, ary1=H*0.20, arCx=W*0.64, arCy=H*0.04;
      for (let i = 0; i < archN - half; i++) {
        const t = i / Math.max(1, (archN - half) - 1);
        const x = (1-t)*(1-t)*aMx + 2*t*(1-t)*arCx + t*t*arx1;
        const y = (1-t)*(1-t)*aMy + 2*t*(1-t)*arCy + t*t*ary1;
        bPts.push({ x: ox+x + Math.sin(i*23.1+1.4)*9, y: oy+y + Math.cos(i*23.1+1.4)*6 });
      }

      /* — left pillar — */
      for (let i = 0; i < leftN; i++) {
        const t = i / leftN;
        bPts.push({
          x: ox + W*0.11 + Math.sin(i*17.7)*9,
          y: oy + H*(0.06 + t*0.80),
        });
      }

      /* — right pillar — */
      for (let i = 0; i < rightN; i++) {
        const t = i / rightN;
        bPts.push({
          x: ox + W*0.89 + Math.sin(i*13.9+2.2)*9,
          y: oy + H*(0.06 + t*0.80),
        });
      }

      /* — bottom base — */
      for (let i = 0; i < botN; i++) {
        const t = i / Math.max(1, botN - 1);
        bPts.push({
          x: ox + W*(0.07 + t*0.86),
          y: oy + H*0.90 + Math.sin(i*11.3+3.1)*8,
        });
      }

      /* shuffle so petals don't all go to neighbouring positions */
      for (let i = bPts.length - 1; i > 0; i--) {
        const j = Math.floor(((Math.sin(i*127.1+3.14)+1)/2)*(i+1));
        [bPts[i], bPts[j]] = [bPts[j], bPts[i]];
      }

      /* ── per-petal targets + ripple delays ── */
      const tgts = petals.map((p, i) => {
        const bp  = bPts[i % bPts.length];
        const px  = lr.left + (p.lp/100)*lr.width;
        const py  = lr.top  + (p.tp/100)*lr.height;
        const dx  = bp.x - px;
        const dy  = bp.y - py;
        const len = Math.sqrt(dx*dx+dy*dy) + 0.001;

        /* ripple delay — petals near the tap launch first */
        const dTap  = Math.sqrt((px-tapX)**2+(py-tapY)**2);
        const maxD  = Math.sqrt(lr.width**2+lr.height**2);
        const delay = (dTap/maxD)*350 + ((Math.sin(i*53.1+2.1)+1)/2)*60;

        /* perpendicular unit vector for the oscillation during flight */
        return { dx, dy, delay, oscX: -dy/len, oscY: dx/len };
      });

      /* ── cinematic rAF loop ── */
      const BASE_DUR = 1800;
      const durs  = petals.map(p => BASE_DUR + Math.sin(p.id*37.9+1.1)*300);
      let maxEnd  = 0;
      petals.forEach((_,i) => { maxEnd = Math.max(maxEnd, tgts[i].delay + durs[i]); });

      /* easing functions */
      const easeOutQuint = t => 1 - Math.pow(1-t, 5);
      const easeOutCubic = t => 1 - Math.pow(1-t, 3);

      const start  = performance.now();
      let   fired  = false;

      const tick = (now) => {
        const elapsed = now - start;
        let allDone   = true;

        petals.forEach((p, i) => {
          const el = elRefs.current[i];
          if (!el) return;

          const local = elapsed - tgts[i].delay;
          if (local < 0) { allDone = false; return; }

          const raw  = Math.min(1, local / durs[i]);
          if (raw < 1) allDone = false;

          const posP = easeOutQuint(raw);             // smooth deceleration into landing
          const tx   = tgts[i].dx * posP;
          const ty   = tgts[i].dy * posP;

          /* gentle lateral drift — a sinusoidal wave across the flight path, dying out */
          const osc  = Math.sin(raw*Math.PI*p.oscF*2) * p.oscA * Math.sin(raw*Math.PI);
          const ox   = tgts[i].oscX * osc;
          const oy_  = tgts[i].oscY * osc;

          /* graceful lift arc — rises at start, settles at end */
          const lift = Math.sin(raw*Math.PI) * (-28);

          /* rotation settles as it lands */
          const angle = p.rot + p.spin * easeOutCubic(raw);

          /* blooms open mid-journey, returns to natural scale */
          const sc = 1 + 0.18*Math.sin(raw*Math.PI);

          el.style.transform =
            `translate(calc(-50% + ${tx+ox}px), calc(-50% + ${ty+oy_+lift}px)) ` +
            `rotate(${angle}deg) scale(${sc})`;
        });

        if (!fired && allDone) {
          fired = true;
          stateRef.current = 'done';
          setTimeout(() => onComplete && onComplete(), 350);
          return;
        }
        if (!fired) rafRef.current = requestAnimationFrame(tick);
      };

      rafRef.current = requestAnimationFrame(tick);
    };

    const noScroll = e => e.preventDefault();
    layer.addEventListener('pointerdown', handleTap);
    layer.addEventListener('touchstart',  noScroll, { passive: false });
    layer.addEventListener('touchmove',   noScroll, { passive: false });
    return () => {
      cancelAnimationFrame(floatRaf);
      if (rafRef.current) cancelAnimationFrame(rafRef.current);
      layer.removeEventListener('pointerdown', handleTap);
      layer.removeEventListener('touchstart',  noScroll);
      layer.removeEventListener('touchmove',   noScroll);
    };
  }, [petals, onComplete]);

  return (
    <div
      className="feather-layer"
      ref={layerRef}
      style={{
        touchAction:   'none',
        cursor:        isRevealed ? 'default' : 'pointer',
        opacity:       isRevealed ? 0 : 1,
        transition:    isRevealed ? 'opacity 3000ms ease 600ms' : undefined,
        pointerEvents: isRevealed ? 'none' : undefined,
      }}
    >
      {petals.map((p, i) => (
        <div
          key={p.id}
          ref={el => { elRefs.current[i] = el; }}
          style={{
            position:      'absolute',
            left:          `${p.lp}%`,
            top:           `${p.tp}%`,
            width:         `${p.sz}%`,
            zIndex:        p.z,
            opacity:       1,
            transform:     `translate(-50%, -50%) rotate(${p.rot}deg)`,
            pointerEvents: 'none',
          }}
        >
          <img src="assets/petal_shaadi.webp" alt="" draggable="false"
            style={{ display:'block', width:'100%', height:'auto',
              userSelect:'none', WebkitUserDrag:'none',
              pointerEvents:'none' }} />
        </div>
      ))}
    </div>
  );
}


/* ─────────────────────────────────────────────
   SaveTheDate — top-level page
───────────────────────────────────────────── */
function SaveTheDate({
  title      = 'Save the Date',
  coupleName = 'Chitra & Prateek',
  date       = '14 June 2026',
  venue      = 'The Westin Sohna',
  location   = 'Gurgaon, Haryana',
  showVenue  = true,
  showCity   = true,
}) {
  const _gallery = !!(window.__STD_GALLERY_MODE__);
  const [phase,    setPhase]    = useState(_gallery ? 'card' : 'intro');
  const [tapped,   setTapped]   = useState(false);
  const [cardIn,   setCardIn]   = useState(_gallery);
  const [revealed, setRevealed] = useState(false);
  const videoRef = useRef(null);

  const dateParts = useMemo(() => {
    const m = /^(\d+)\s+(\w+)\s+(\d{4})$/.exec(date.trim());
    if (m) return { day: m[1].padStart(2, '0'), month: m[2], year: m[3] };
    return { day: date, month: '', year: '' };
  }, [date]);

  const coupleParts = useMemo(() => {
    const m = /^(.+?)\s*&\s*(.+)$/.exec(coupleName);
    return m ? { a: m[1].trim(), b: m[2].trim() } : { a: coupleName, b: '' };
  }, [coupleName]);

  const transitionToCard = () => {
    setPhase('transition');
    setTimeout(() => {
      setPhase('card');
      requestAnimationFrame(() => requestAnimationFrame(() => setCardIn(true)));
    }, 1100);
  };

  const handleIntroTap = () => {
    if (tapped) return;
    setTapped(true);
    const v = videoRef.current;
    if (!v) { transitionToCard(); return; }
    v.muted = true;
    setPhase('video');
    const p = v.play();
    if (p && p.catch) p.catch(() => transitionToCard());
  };

  // seek to first frame once the browser has decoded data — currentTime=0.001 forces the frame to paint
  useEffect(() => {
    const v = videoRef.current;
    if (!v) return;
    const showFirstFrame = () => { try { v.currentTime = 0.001; } catch (_) {} };
    if (v.readyState >= 2) showFirstFrame();
    else v.addEventListener('loadeddata', showFirstFrame, { once: true });
    return () => v.removeEventListener('loadeddata', showFirstFrame);
  }, []);

  return (
    <div className="stage">
      {phase !== 'card' && (
        <div className={`intro ${phase === 'transition' ? 'fade-out' : ''}`} onClick={handleIntroTap}>
          <video ref={videoRef} src="assets/intro.mp4" poster="assets/poster.png" playsInline preload="auto" muted onEnded={transitionToCard} />
          <div className={`intro-veil ${tapped ? 'hidden' : ''}`} />
          <div className={`tap-prompt ${tapped ? 'hidden' : ''}`}>
            <div className="flourish">
              <span className="line" /><span className="glyph">✦</span><span className="line" />
            </div>
            <div className="prompt-label">Tap to Begin</div>
            <div className="prompt-sub">a wedding invitation</div>
          </div>
        </div>
      )}

      {(phase === 'card' || phase === 'transition') && (
        <div className={`card ${cardIn ? 'in' : ''} ${revealed ? 'revealed' : ''}`}>
          <div className="card-bg" />

          <header className="card-header">
            <div className="eyebrow">
              <span className="rule" /><span className="diamond" /><span className="rule" />
            </div>
            <h1 className="title">{title}</h1>
            <div className="couple">
              <span className="name">{coupleParts.a}</span>
              <span className="amp">&amp;</span>
              <span className="name">{coupleParts.b}</span>
            </div>
          </header>

          <div className="jharoka-wrap">
            <img src="assets/Jharoka.png" alt="" className="jharoka-img" draggable="false" />
            <div className="jharoka-inner">
              <div className="date-block" aria-hidden={!revealed}>
                <div className="glow" />
                <div className="preamble">— join us on —</div>
                <div className="day-row"><span className="day">{dateParts.day}</span></div>
                <div className="month-row">
                  <span className="bar" /><span className="month">{dateParts.month}</span><span className="bar" />
                </div>
                <div className="year">{dateParts.year}</div>
                <div className="sep" aria-hidden="true">
                  <span className="dot" /><span className="dot" /><span className="dot" />
                </div>
                {showVenue && <div className="venue">{venue}</div>}
                {showCity && <div className="loc">{location}</div>}
              </div>
            </div>

            <PetalLayer onComplete={() => setRevealed(true)} isRevealed={revealed} />
            {!revealed && <div className="reveal-hint"><span>tap to reveal</span></div>}
          </div>

          <footer className="card-footer">
            <div className="formal">
              <span className="ornament">❀</span>
              <span>Formal invitation to follow</span>
              <span className="ornament">❀</span>
            </div>
          </footer>
        </div>
      )}
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
const _cfg = window.__STD_CONFIG__ || {};
root.render(
  <SaveTheDate
    title={_cfg.title || 'Save the Date'}
    coupleName={_cfg.coupleName || 'Chitra & Prateek'}
    date={_cfg.date || '14 June 2026'}
    venue={_cfg.venue || 'The Westin Sohna'}
    location={_cfg.location || 'Gurgaon, Haryana'}
    showVenue={_cfg.showVenue !== false}
    showCity={_cfg.showCity !== false}
  />
);
</script>
</body>
</html>
